<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ToolBax.App.ViewModels"
        xmlns:models="using:ToolBax.App.Models"
        xmlns:views="using:ToolBax.App.Views"
        x:Class="ToolBax.App.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="toolBax"
        Width="1280" Height="800"
        Background="{StaticResource AppBackgroundBrush}">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+K" Command="{Binding OpenCommandPaletteCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding CloseCommandPaletteCommand}" />
  </Window.KeyBindings>

  <Panel>
    <!-- Shell: header / [nav | content] / status strip -->
    <Grid RowDefinitions="48,*,26">

      <!-- Header / caption -->
      <Border Grid.Row="0"
              Background="{StaticResource MicaBrush}"
              BorderBrush="{StaticResource StrokeBrush}"
              BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="14,0">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="toolBax" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text0Brush}" />
            <TextBlock Text="{Binding ActiveEnvironment.Name, StringFormat='— {0}'}"
                       FontSize="13" VerticalAlignment="Center" Foreground="{StaticResource Text2Brush}" />
          </StackPanel>

          <!-- Command-palette search affordance -->
          <Button Grid.Column="1"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Width="360" Height="30"
                  Command="{Binding OpenCommandPaletteCommand}"
                  Background="{StaticResource Layer2Brush}"
                  BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                  CornerRadius="4">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="Search tools &amp; run commands"
                         VerticalAlignment="Center" Foreground="{StaticResource Text3Brush}" FontSize="12.5" />
              <Border Grid.Column="1" Background="{StaticResource Layer3Brush}" CornerRadius="3" Padding="6,1">
                <TextBlock Text="Ctrl+K" FontSize="11" Foreground="{StaticResource Text2Brush}" />
              </Border>
            </Grid>
          </Button>
        </Grid>
      </Border>

      <!-- Body: nav rail + content -->
      <Grid Grid.Row="1" ColumnDefinitions="220,*">

        <Border Grid.Column="0"
                Background="{StaticResource MicaBrush}"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,1,0">
          <ListBox x:Name="NavRail"
                   ItemsSource="{Binding Tools}"
                   SelectedItem="{Binding CurrentTool, Mode=TwoWay}"
                   Background="Transparent" BorderThickness="0" Padding="6">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="models:NavTool">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" />
                  <Border Grid.Column="1" IsVisible="{Binding IsLive}"
                          Background="{StaticResource WarnBgBrush}" CornerRadius="999" Padding="6,1">
                    <TextBlock Text="live" FontSize="10" Foreground="{StaticResource WarnBrush}" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>

        <!-- Content host: routes the current tool's VM to its view (DataTemplates). -->
        <Border Grid.Column="1" Background="{StaticResource Layer1Brush}">
          <ContentControl Content="{Binding CurrentContent}">
            <ContentControl.DataTemplates>
              <DataTemplate DataType="vm:DualWriteOpsViewModel">
                <views:DualWriteOpsView />
              </DataTemplate>
              <DataTemplate DataType="vm:ProfilesViewModel">
                <views:ProfilesView />
              </DataTemplate>
              <DataTemplate DataType="vm:MetadataViewModel">
                <views:MetadataView />
              </DataTemplate>
              <DataTemplate DataType="vm:PostBuilderViewModel">
                <views:PostBuilderView />
              </DataTemplate>
              <DataTemplate DataType="vm:PlaceholderScreenViewModel">
                <views:PlaceholderScreenView />
              </DataTemplate>
            </ContentControl.DataTemplates>
          </ContentControl>
        </Border>
      </Grid>

      <!-- Status strip -->
      <Border Grid.Row="2"
              Background="{StaticResource MicaBrush}"
              BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0">
        <StackPanel Orientation="Horizontal" Spacing="14" Margin="14,0" VerticalAlignment="Center">
          <TextBlock x:Name="StatusToolLabel" Text="{Binding CurrentTool.Title}"
                     FontSize="11.5" Foreground="{StaticResource Text2Brush}" />
          <TextBlock Text="{Binding ActiveEnvironment.Name}"
                     FontSize="11.5" Foreground="{StaticResource Text2Brush}" />
          <TextBlock FontSize="11.5" Foreground="{StaticResource Text3Brush}"
                     Text="{Binding IsBusy, StringFormat='busy: {0}'}" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Command palette overlay -->
    <Panel x:Name="CommandPaletteOverlay" IsVisible="{Binding IsCommandPaletteOpen}"
           Background="#88000000">
      <Border Width="560" MaxHeight="420"
              VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,120,0,0"
              Background="{StaticResource Layer1Brush}"
              BorderBrush="{StaticResource Stroke2Brush}" BorderThickness="1"
              CornerRadius="8"
              DataContext="{Binding Palette}" x:DataType="vm:CommandPaletteViewModel">
        <DockPanel Margin="8">
          <TextBox DockPanel.Dock="Top"
                   Text="{Binding Query, Mode=TwoWay}"
                   PlaceholderText="Search tools &amp; run commands…"
                   KeyDown="OnPaletteKeyDown"
                   Margin="4" />
          <ListBox x:Name="PaletteResults"
                   ItemsSource="{Binding FilteredCommands}"
                   Background="Transparent" BorderThickness="0"
                   DoubleTapped="OnPaletteResultActivated">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="models:NavTool">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding ShortcutLabel}"
                             FontSize="11" Foreground="{StaticResource Text3Brush}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Panel>
  </Panel>
</Window>
