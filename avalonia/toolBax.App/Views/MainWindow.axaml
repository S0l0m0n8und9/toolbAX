<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ToolBax.App.ViewModels"
        xmlns:models="using:ToolBax.App.Models"
        xmlns:core="using:ToolBax.Core.Models"
        xmlns:conv="using:ToolBax.App.Converters"
        xmlns:views="using:ToolBax.App.Views"
        x:Class="ToolBax.App.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="toolBax"
        Icon="/Assets/icon.png"
        Width="1280" Height="800"
        Background="{StaticResource AppBackgroundBrush}">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+K" Command="{Binding OpenCommandPaletteCommand}" />
    <KeyBinding Gesture="Escape" Command="{Binding CloseCommandPaletteCommand}" />
  </Window.KeyBindings>

  <Panel>
    <!-- Shell: degraded banner / header / [nav | content] / status strip -->
    <Grid RowDefinitions="Auto,48,*,26">

      <!-- Degraded-mode banner (#164): the offline fake stack is wired, so nothing on screen is live. -->
      <Border Grid.Row="0" x:Name="DegradedBanner"
              IsVisible="{Binding IsDegraded}"
              Background="{StaticResource WarnBrush}">
        <TextBlock Text="{Binding DegradedBannerText}" Margin="14,7"
                   FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"
                   Foreground="{StaticResource OnAccentBrush}" />
      </Border>

      <!-- Header / caption -->
      <Border Grid.Row="1" x:Name="HeaderBar"
              Background="{StaticResource MicaBrush}"
              BorderBrush="{StaticResource StrokeBrush}"
              BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="14,0">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock Text="toolBax" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text0Brush}" />

            <!-- Environment switcher (control-map §0.3): the header entry point for a deliberate active-
                 environment switch, alongside Profiles' "Set active". It replaces the read-only "— {env}"
                 label this cluster used to carry, and shows the same name plus the status dot.
                 SelectedItem is deliberately OneWay: the view model stays the single source of truth, so
                 an externally-driven change (Profiles) or the switch funnel's rollback re-syncs the box,
                 and a user pick is routed through SetActiveEnvironmentCommand by the code-behind rather
                 than written straight back onto ActiveEnvironment (which would skip persistence and the
                 refresh prompt). -->
            <ComboBox x:Name="EnvSwitcher" MinWidth="210" VerticalAlignment="Center"
                      ItemsSource="{Binding Environments}"
                      SelectedItem="{Binding ActiveEnvironment, Mode=OneWay}"
                      SelectionChanged="OnEnvironmentSelectionChanged"
                      ToolTip.Tip="Switch the active environment">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="core:EnvProfile">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <!-- Status dot: connected→ok, token-expired→warn, disconnected→err. -->
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                             Fill="{Binding Status, Converter={x:Static conv:EnvStatusToBrushConverter.Instance}}" />
                    <TextBlock Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <!-- Command-palette search affordance -->
          <Button Grid.Column="1"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Width="360" Height="30"
                  Command="{Binding OpenCommandPaletteCommand}"
                  Background="{StaticResource Layer2Brush}"
                  BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                  CornerRadius="4">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="Search tools &amp; run commands"
                         VerticalAlignment="Center" Foreground="{StaticResource Text3Brush}" FontSize="12.5" />
              <Border Grid.Column="1" Background="{StaticResource Layer3Brush}" CornerRadius="3" Padding="6,1">
                <TextBlock Text="Ctrl+K" FontSize="11" Foreground="{StaticResource Text2Brush}" />
              </Border>
            </Grid>
          </Button>
        </Grid>
      </Border>

      <!-- Body: nav rail + content -->
      <Grid Grid.Row="2" ColumnDefinitions="220,*">

        <Border Grid.Column="0"
                Background="{StaticResource MicaBrush}"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,1,0">
          <ListBox x:Name="NavRail"
                   ItemsSource="{Binding Tools}"
                   SelectedItem="{Binding CurrentTool, Mode=TwoWay}"
                   Background="Transparent" BorderThickness="0" Padding="6">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="models:NavTool">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" />
                  <Border Grid.Column="1" IsVisible="{Binding IsLive}"
                          Background="{StaticResource WarnBgBrush}" CornerRadius="999" Padding="6,1">
                    <TextBlock Text="live" FontSize="11" Foreground="{StaticResource WarnBrush}" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>

        <!-- Content host: routes the current tool's VM to its view (DataTemplates). -->
        <Border Grid.Column="1" Background="{StaticResource Layer1Brush}">
          <ContentControl Content="{Binding CurrentContent}">
            <ContentControl.DataTemplates>
              <DataTemplate DataType="vm:PluginsHomeViewModel">
                <views:PluginsHomeView />
              </DataTemplate>
              <DataTemplate DataType="vm:DualWriteOpsViewModel">
                <views:DualWriteOpsView />
              </DataTemplate>
              <DataTemplate DataType="vm:ProfilesViewModel">
                <views:ProfilesView />
              </DataTemplate>
              <DataTemplate DataType="vm:MetadataViewModel">
                <views:MetadataView />
              </DataTemplate>
              <DataTemplate DataType="vm:VirtualTablesViewModel">
                <views:VirtualTablesView />
              </DataTemplate>
              <DataTemplate DataType="vm:PostBuilderViewModel">
                <views:PostBuilderView />
              </DataTemplate>
              <DataTemplate DataType="vm:QueryBuilderViewModel">
                <views:QueryBuilderView />
              </DataTemplate>
              <DataTemplate DataType="vm:DualWriteMapViewModel">
                <views:DualWriteMapView />
              </DataTemplate>
              <DataTemplate DataType="vm:DualWriteCompareViewModel">
                <views:DualWriteCompareView />
              </DataTemplate>
              <DataTemplate DataType="vm:PlaceholderScreenViewModel">
                <views:PlaceholderScreenView />
              </DataTemplate>
            </ContentControl.DataTemplates>
          </ContentControl>
        </Border>
      </Grid>

      <!-- Status strip -->
      <Border Grid.Row="3" x:Name="StatusStrip"
              Background="{StaticResource MicaBrush}"
              BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0">
        <StackPanel Orientation="Horizontal" Spacing="14" Margin="14,0" VerticalAlignment="Center">
          <TextBlock x:Name="StatusToolLabel" Text="{Binding CurrentTool.Title}"
                     FontSize="11.5" Foreground="{StaticResource Text2Brush}" />
          <TextBlock x:Name="StatusEnvLabel" Text="{Binding ActiveEnvironment.Name}"
                     FontSize="11.5" Foreground="{StaticResource Text2Brush}" />
          <!-- No busy segment: nothing ever set ShellViewModel.IsBusy (each tool owns and shows its own
               busy state), so the strip only ever read "busy: False". Aggregating per-tool busy states up
               to the shell would be speculative plumbing for a segment no tool asked for. -->
          <TextBlock x:Name="BackgroundErrorText" Text="{Binding BackgroundError}"
                     FontSize="11.5" Foreground="{StaticResource WarnBrush}" TextTrimming="CharacterEllipsis"
                     IsVisible="{Binding BackgroundError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Command palette overlay -->
    <Panel x:Name="CommandPaletteOverlay" IsVisible="{Binding IsCommandPaletteOpen}"
           Background="{StaticResource ScrimBrush}">
      <Border Width="560" MaxHeight="420"
              VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,120,0,0"
              Background="{StaticResource Layer1Brush}"
              BorderBrush="{StaticResource Stroke2Brush}" BorderThickness="1"
              CornerRadius="8"
              DataContext="{Binding Palette}" x:DataType="vm:CommandPaletteViewModel">
        <DockPanel Margin="8">
          <TextBox DockPanel.Dock="Top"
                   Text="{Binding Query, Mode=TwoWay}"
                   PlaceholderText="Search tools &amp; run commands…"
                   KeyDown="OnPaletteKeyDown"
                   Margin="4" />
          <ListBox x:Name="PaletteResults"
                   ItemsSource="{Binding FilteredCommands}"
                   Background="Transparent" BorderThickness="0"
                   DoubleTapped="OnPaletteResultActivated">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="models:NavTool">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding ShortcutLabel}"
                             FontSize="11" Foreground="{StaticResource Text3Brush}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Panel>
  </Panel>
</Window>
