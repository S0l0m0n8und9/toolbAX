<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ToolBax.App.ViewModels"
             xmlns:models="using:ToolBax.Core.Models"
             xmlns:conv="using:ToolBax.App.Converters"
             x:Class="ToolBax.App.Views.ProfilesView"
             x:DataType="vm:ProfilesViewModel">

  <UserControl.Styles>
    <!-- Inline-editable header title: reads as a heading at rest (no box), shows the accent underline
         on focus. Realised by overriding the Fluent TextBox state brushes to transparent rather than
         hand-rolling a template (CLAUDE.md: override resources, don't re-template). -->
    <Style Selector="TextBox.profileTitle">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource Text0Brush}" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="MinWidth" Value="120" />
      <Setter Property="MaxWidth" Value="520" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="280,*">

    <!-- Master: search + environment list -->
    <Border Grid.Column="0" Background="{StaticResource MicaBrush}"
            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="10">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto" Margin="0,0,0,8" ColumnSpacing="6">
          <Button Grid.Column="0" Content="+ Add" Command="{Binding AddProfileCommand}" />
          <!-- Delete is disabled at one profile so at least one environment always remains. -->
          <Button Grid.Column="1" Content="Delete" Command="{Binding DeleteProfileCommand}"
                  IsEnabled="{Binding CanDeleteProfile}" />
        </Grid>
        <TextBox DockPanel.Dock="Top" Text="{Binding Search, Mode=TwoWay}"
                 PlaceholderText="Search environments…" Margin="0,0,0,8" />
        <ListBox x:Name="ProfilesList"
                 ItemsSource="{Binding Filtered}"
                 SelectedItem="{Binding Selected, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:EnvProfile">
              <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                <!-- Status dot: connected→ok, token-expired→warn, disconnected→err. -->
                <Ellipse x:Name="StatusDot" Grid.Column="0" Width="7" Height="7" VerticalAlignment="Top" Margin="2,6,0,0"
                         Fill="{Binding Status, Converter={x:Static conv:EnvStatusToBrushConverter.Instance}}" />
                <StackPanel Grid.Column="1" Spacing="1" Margin="8,0,0,0">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource Text0Brush}"
                               TextTrimming="CharacterEllipsis" />
                    <Border CornerRadius="999" Padding="7,0" Background="{StaticResource AccentTintBrush}"
                            VerticalAlignment="Center">
                      <Border.IsVisible>
                        <MultiBinding Converter="{x:Static conv:EnvIsActiveConverter.Instance}">
                          <Binding Path="Id" />
                          <Binding Path="((vm:ProfilesViewModel)DataContext).ActiveId"
                                   RelativeSource="{RelativeSource AncestorType=ListBox}" />
                        </MultiBinding>
                      </Border.IsVisible>
                      <TextBlock Text="active" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource Text3Brush}"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Detail: scrolling content above a pinned status footer. -->
    <DockPanel Grid.Column="1">
      <Border DockPanel.Dock="Bottom" Background="{StaticResource MicaBrush}"
              BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0" MinHeight="30" Padding="18,0">
        <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{StaticResource Text2Brush}"
                   VerticalAlignment="Center" />
      </Border>

      <ScrollViewer>
        <StackPanel Margin="24,16" Spacing="14" IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">

          <!-- Header: the profile Name is the inline-editable title (it relates to the profile itself,
               so it lives here rather than on the FO tab). -->
          <Grid ColumnDefinitions="Auto,Auto,*">
            <TextBox x:Name="DetailTitle" Grid.Column="0" Classes="profileTitle"
                     Text="{Binding DraftName, Mode=TwoWay}" PlaceholderText="New environment">
              <TextBox.Resources>
                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />
              </TextBox.Resources>
            </TextBox>
            <Border Grid.Column="1" IsVisible="{Binding IsSelectedActive}" VerticalAlignment="Center"
                    Background="{StaticResource AccentTintBrush}" CornerRadius="999" Padding="8,2" Margin="8,0,0,0">
              <TextBlock Text="active" FontSize="11" Foreground="{StaticResource AccentBrush}" />
            </Border>
          </Grid>

          <!-- Profile-level actions sit above the tab strip so they're reachable from every tab
               (Set active / Save). Tab-specific Test buttons stay inside their tabs. -->
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{Binding SetActiveLabel}" Command="{Binding SetActiveCommand}"
                    IsEnabled="{Binding CanSetActive}" />
            <Button Content="Save" Command="{Binding SaveCommand}"
                    Background="{StaticResource AccentBrush}" Foreground="{StaticResource OnAccentBrush}" />
          </StackPanel>

          <TabControl>
            <!-- FO Environment fields + authentication (editable; committed by Save). -->
            <TabItem Header="FO Environment">
              <StackPanel Spacing="14" Margin="0,12,0,0">
                <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Base URL" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                  <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DraftUrl, Mode=TwoWay}"
                           PlaceholderText="https://contoso.operations.dynamics.com"
                           FontFamily="{StaticResource MonoFontFamily}" />
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Tenant ID" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                  <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DraftTenant, Mode=TwoWay}"
                           FontFamily="{StaticResource MonoFontFamily}" />
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Default company" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                  <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DraftLegal, Mode=TwoWay}" PlaceholderText="USMF" />
                  <TextBlock Grid.Row="3" Grid.Column="0" Text="Environment type" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                  <ComboBox Grid.Row="3" Grid.Column="1" Width="220" HorizontalAlignment="Left"
                            ItemsSource="{Binding EnvironmentTypes}" SelectedItem="{Binding DraftEnvironmentType, Mode=TwoWay}" />
                </Grid>

                <!-- Authentication -->
                <Separator />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Authentication" FontWeight="SemiBold" Foreground="{StaticResource Text1Brush}"
                             VerticalAlignment="Center" />
                  <Border IsVisible="{Binding HasSecret}" Background="{StaticResource OkBgBrush}"
                          CornerRadius="999" Padding="8,1" VerticalAlignment="Center">
                    <TextBlock Text="secret stored" FontSize="11" Foreground="{StaticResource OkBrush}" />
                  </Border>
                </StackPanel>

                <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Auth mode" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                  <ComboBox x:Name="FoAuthModeSelector" Grid.Row="0" Grid.Column="1" Width="220" HorizontalAlignment="Left"
                            ItemsSource="{Binding AuthModes}" SelectedItem="{Binding SelectedFoAuthMode, Mode=TwoWay}"
                            PlaceholderText="Choose a supported mode">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="models:FoAuthMode">
                        <TextBlock Text="{Binding Converter={x:Static conv:FoAuthModeLabelConverter.Instance}}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Client ID" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                  <TextBox x:Name="FoClientIdInput" Grid.Row="1" Grid.Column="1" Text="{Binding DraftClientId, Mode=TwoWay}"
                           IsEnabled="{Binding CanEditFoClientId}"
                           PlaceholderText="App (client) ID" FontFamily="{StaticResource MonoFontFamily}" />
                  <TextBlock Grid.Row="2" Grid.Column="1" IsVisible="{Binding ShowFoDefaultClientIdNote}"
                             Text="Default global Client ID from Microsoft (editable)." FontSize="11"
                             Foreground="{StaticResource Text3Brush}" />
                </Grid>

                <Border x:Name="FoUnsupportedAuthWarning" IsVisible="{Binding HasUnsupportedFoAuthMode}"
                        Background="{StaticResource WarnBgBrush}" BorderBrush="{StaticResource WarnBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12,8">
                  <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Text1Brush}"
                             Text="This saved authentication mode is unsupported. Other edits preserve its legacy settings; choose Interactive or Client secret to replace it." />
                </Border>

                <!-- Client secret only applies to the app-only ClientSecret mode. -->
                <Grid IsVisible="{Binding IsFoClientSecretMode}" ColumnDefinitions="130,*,Auto,Auto" ColumnSpacing="8">
                  <TextBlock Grid.Column="0" Text="Client secret" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding SecretInput, Mode=TwoWay}" PasswordChar="●"
                           PlaceholderText="Enter a new secret to store" FontFamily="{StaticResource MonoFontFamily}" />
                  <Button Grid.Column="2" Content="Store" Command="{Binding SaveSecretCommand}" />
                  <Button Grid.Column="3" Content="Clear" Command="{Binding ClearSecretCommand}" />
                </Grid>

                <!-- Tab-specific connection test stays in the FO tab. -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Test connection" Command="{Binding TestConnectionCommand}" />
                  <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsTestingFoConnection}" Width="90" Height="4"
                               VerticalAlignment="Center" />
                  <!-- Clears the cached delegated sign-in so the next call re-authenticates. Scope is the
                       whole tenant, not this profile: the MSAL cache is keyed clientId|tenantId and
                       sign-out deletes that blob, and every Interactive profile shares the one app
                       registration. Keep this wording in step with ProfilesViewModel.SignOut's status
                       (and the ceiling noted there) — a per-profile promise here would be a lie. -->
                  <Button Content="Sign out" Command="{Binding SignOutCommand}"
                          ToolTip.Tip="Clear the cached sign-in for every profile using this tenant's shared app registration (forces a fresh interactive sign-in next time)." />
                </StackPanel>
              </StackPanel>
            </TabItem>

            <!-- CE / Dataverse: linked Dataverse environment for dual-write. -->
            <TabItem Header="CE · Dataverse">
              <StackPanel Spacing="12" Margin="0,12,0,0">
                <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Dataverse URL" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                  <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DraftDataverseUrl, Mode=TwoWay}"
                           PlaceholderText="org.crm.dynamics.com" FontFamily="{StaticResource MonoFontFamily}" />
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Tenant ID" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                  <TextBox Grid.Row="1" Grid.Column="1" IsReadOnly="True" Text="{Binding DraftTenant}" Opacity="0.7"
                           FontFamily="{StaticResource MonoFontFamily}" />
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Auth mode" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                  <ComboBox x:Name="DataverseAuthModeSelector" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch"
                            ItemsSource="{Binding AuthModes}" SelectedItem="{Binding SelectedDataverseAuthMode, Mode=TwoWay}"
                            PlaceholderText="Choose a supported mode">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="models:FoAuthMode">
                        <TextBlock Text="{Binding Converter={x:Static conv:FoAuthModeLabelConverter.Instance}}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Grid.Row="3" Grid.Column="0" Text="Client ID" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                  <TextBox x:Name="DataverseClientIdInput" Grid.Row="3" Grid.Column="1" Text="{Binding DraftDataverseClientId, Mode=TwoWay}"
                           IsEnabled="{Binding CanEditDataverseClientId}"
                           PlaceholderText="Dataverse app (client) ID" FontFamily="{StaticResource MonoFontFamily}" />
                  <TextBlock Grid.Row="4" Grid.Column="1" IsVisible="{Binding ShowDataverseDefaultClientIdNote}"
                             Text="Default global Client ID from Microsoft (editable)." FontSize="11"
                             Foreground="{StaticResource Text3Brush}" />
                  <TextBlock Grid.Row="5" Grid.Column="0" Text="Web API" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                  <TextBox Grid.Row="5" Grid.Column="1" IsReadOnly="True" Text="{Binding DataverseWebApi, Mode=OneWay}" Opacity="0.7"
                           FontFamily="{StaticResource MonoFontFamily}" />
                </Grid>

                <Border x:Name="DataverseUnsupportedAuthWarning" IsVisible="{Binding HasUnsupportedDataverseAuthMode}"
                        Background="{StaticResource WarnBgBrush}" BorderBrush="{StaticResource WarnBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12,8">
                  <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Text1Brush}"
                             Text="This saved authentication mode is unsupported. Other edits preserve its legacy settings; choose Interactive or Client secret to replace it." />
                </Border>

                <Grid ColumnDefinitions="130,*,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding IsDataverseClientSecretMode}">
                  <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Client secret" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                    <Border IsVisible="{Binding HasDataverseSecret}" Background="{StaticResource OkBgBrush}"
                            CornerRadius="999" Padding="6,1" VerticalAlignment="Center">
                      <TextBlock Text="set" FontSize="11" Foreground="{StaticResource OkBrush}" />
                    </Border>
                  </StackPanel>
                  <TextBox Grid.Column="1" Text="{Binding DataverseSecretInput, Mode=TwoWay}" PasswordChar="●"
                           PlaceholderText="Enter a new Dataverse secret to store" FontFamily="{StaticResource MonoFontFamily}" />
                  <Button Grid.Column="2" Content="Store" Command="{Binding SaveDataverseSecretCommand}" />
                  <Button Grid.Column="3" Content="Clear" Command="{Binding ClearDataverseSecretCommand}" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Content="Test Dataverse connection" Command="{Binding TestDataverseConnectionCommand}" />
                  <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsTestingDataverseConnection}" Width="90" Height="4"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource Text3Brush}"
                           Text="The linked Dataverse environment + its own app registration (used by Dual-Write). The Dataverse client ID is a separate app reg from the FO one; the tenant is shared with the FO environment. The client secret is DPAPI-protected at rest and never displayed or logged." />
              </StackPanel>
            </TabItem>

            <!-- Data Integrator: the supported App path is portal browser sign-in only. -->
            <TabItem Header="Data Integrator">
              <StackPanel Spacing="12" Margin="0,12,0,0">
                <Border Background="{StaticResource InfoBgBrush}" BorderBrush="{StaticResource InfoBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12,8">
                  <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Text1Brush}"
                             Text="Used by Dual-Write Operations &amp; Compare. Sign-in opens the Microsoft Data Integrator portal and discovers the delegated token and regional gateway automatically." />
                </Border>

                <Border x:Name="LegacyDiWarning" IsVisible="{Binding HasLegacyDiConfiguration}"
                        Background="{StaticResource WarnBgBrush}" BorderBrush="{StaticResource WarnBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12,8">
                  <StackPanel Spacing="8">
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Text1Brush}"
                               Text="This profile has retained legacy Data Integrator configuration or a password. It is unused by portal sign-in and is preserved on ordinary saves." />
                    <Button x:Name="ClearLegacyDiPasswordButton" IsVisible="{Binding HasDiSecret}" HorizontalAlignment="Left"
                            Content="Clear legacy password" Command="{Binding ClearLegacyDiPasswordCommand}" />
                  </StackPanel>
                </Border>

                <StackPanel Spacing="8">
                  <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource Text3Brush}"
                             Text="Sign-in opens the Microsoft Data Integrator portal in an embedded browser and captures the delegated token AND your regional gateway host automatically — nothing to configure here. Renews silently after the first sign-in. (Windows only.)" />
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="PortalGatewayTestButton" Content="Sign in &amp; test gateway" Command="{Binding TestGatewayCommand}"
                            Background="{StaticResource AccentBrush}" Foreground="{StaticResource OnAccentBrush}" />
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsTestingGateway}" Width="90" Height="4"
                                 VerticalAlignment="Center" />
                  </StackPanel>
                </StackPanel>

                <TextBlock Text="{Binding DiStatus}" FontSize="12" Foreground="{StaticResource Text2Brush}"
                           FontFamily="{StaticResource MonoFontFamily}"
                           IsVisible="{Binding DiStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </TabItem>
          </TabControl>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Grid>
</UserControl>
