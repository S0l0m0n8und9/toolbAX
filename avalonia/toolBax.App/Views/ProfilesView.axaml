<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ToolBax.App.ViewModels"
             xmlns:models="using:ToolBax.Core.Models"
             xmlns:conv="using:ToolBax.App.Converters"
             x:Class="ToolBax.App.Views.ProfilesView"
             x:DataType="vm:ProfilesViewModel">

  <Grid ColumnDefinitions="280,*">

    <!-- Master: search + environment list -->
    <Border Grid.Column="0" Background="{StaticResource MicaBrush}"
            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="10">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto" Margin="0,0,0,8" ColumnSpacing="6">
          <Button Grid.Column="0" Content="+ Add" Command="{Binding AddProfileCommand}" />
          <Button Grid.Column="1" Content="Delete" Command="{Binding DeleteProfileCommand}" />
        </Grid>
        <TextBox DockPanel.Dock="Top" Text="{Binding Search, Mode=TwoWay}"
                 PlaceholderText="Search environments…" Margin="0,0,0,8" />
        <ListBox x:Name="ProfilesList"
                 ItemsSource="{Binding Filtered}"
                 SelectedItem="{Binding Selected, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:EnvProfile">
              <StackPanel Spacing="1" Margin="0,2">
                <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{StaticResource Text0Brush}" />
                <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource Text3Brush}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Detail -->
    <ScrollViewer Grid.Column="1">
      <StackPanel Margin="24,16" Spacing="14" IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">

        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock x:Name="DetailTitle" Text="{Binding Selected.Name}"
                     FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Text0Brush}" />
          <Border IsVisible="{Binding IsSelectedActive}" VerticalAlignment="Center"
                  Background="{StaticResource AccentTintBrush}" CornerRadius="999" Padding="8,2">
            <TextBlock Text="active" FontSize="11" Foreground="{StaticResource AccentBrush}" />
          </Border>
        </StackPanel>

        <TabControl>
          <!-- FO Environment fields (editable; committed by Save). -->
          <TabItem Header="FO Environment">
            <StackPanel Spacing="14" Margin="0,12,0,0">
              <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DraftName, Mode=TwoWay}" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Base URL" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DraftUrl, Mode=TwoWay}"
                         FontFamily="Cascadia Code,Consolas,monospace" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Tenant ID" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DraftTenant, Mode=TwoWay}"
                         FontFamily="Cascadia Code,Consolas,monospace" />
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Default company" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding DraftLegal, Mode=TwoWay}" />
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Tier" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding DraftTier, Mode=TwoWay}" />
              </Grid>

              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Set active" Command="{Binding SetActiveCommand}" />
                <Button Content="Save" Command="{Binding SaveCommand}" />
                <Button Content="Test connection" Command="{Binding TestConnectionCommand}" />
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsTestingConnection}" Width="90" Height="4"
                             VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </TabItem>

          <!-- CE / Dataverse: linked Dataverse environment for dual-write. -->
          <TabItem Header="CE · Dataverse">
            <StackPanel Spacing="12" Margin="0,12,0,0">
              <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Dataverse URL" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DraftDataverseUrl, Mode=TwoWay}"
                         PlaceholderText="org.crm.dynamics.com" FontFamily="Cascadia Code,Consolas,monospace" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Tenant ID" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" IsReadOnly="True" Text="{Binding DraftTenant}"
                         FontFamily="Cascadia Code,Consolas,monospace" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Client ID" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DraftDataverseClientId, Mode=TwoWay}"
                         PlaceholderText="Dataverse app (client) ID" FontFamily="Cascadia Code,Consolas,monospace" />
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Auth mode" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                <ComboBox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch"
                          ItemsSource="{Binding AuthModes}" SelectedItem="{Binding DraftDataverseAuthMode, Mode=TwoWay}" />
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Web API" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                <TextBox Grid.Row="4" Grid.Column="1" IsReadOnly="True" Text="{Binding DataverseWebApi, Mode=OneWay}"
                         FontFamily="Cascadia Code,Consolas,monospace" />
              </Grid>
              <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource Text3Brush}"
                         Text="The linked Dataverse environment + its app registration (used by Dual-Write). The Dataverse client ID is a separate app reg from the FO one; the tenant is shared with the FO environment. The client secret is set on the Auth tab." />
            </StackPanel>
          </TabItem>

          <!-- Auth: service-principal client secret, protected at rest (set/clear only). -->
          <TabItem Header="Auth">
            <StackPanel Spacing="12" Margin="0,12,0,0">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Client credentials" FontWeight="SemiBold" Foreground="{StaticResource Text1Brush}"
                           VerticalAlignment="Center" />
                <Border IsVisible="{Binding HasSecret}" Background="{StaticResource OkBgBrush}"
                        CornerRadius="999" Padding="8,1" VerticalAlignment="Center">
                  <TextBlock Text="secret stored" FontSize="10.5" Foreground="{StaticResource OkBrush}" />
                </Border>
                <Border IsVisible="{Binding !HasSecret}" Background="{StaticResource WarnBgBrush}"
                        CornerRadius="999" Padding="8,1" VerticalAlignment="Center">
                  <TextBlock Text="no secret" FontSize="10.5" Foreground="{StaticResource WarnBrush}" />
                </Border>
              </StackPanel>

              <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto" RowSpacing="6">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Client ID" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DraftClientId, Mode=TwoWay}"
                         PlaceholderText="App (client) ID" FontFamily="Cascadia Code,Consolas,monospace" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Auth mode" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                <ComboBox Grid.Row="1" Grid.Column="1" Width="220" HorizontalAlignment="Left"
                          ItemsSource="{Binding AuthModes}" SelectedItem="{Binding DraftAuthMode, Mode=TwoWay}" />
              </Grid>

              <Grid ColumnDefinitions="130,*,Auto,Auto" ColumnSpacing="8">
                <TextBlock Grid.Column="0" Text="Client secret" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding SecretInput, Mode=TwoWay}" PasswordChar="●"
                         PlaceholderText="Enter a new secret to store" FontFamily="Cascadia Code,Consolas,monospace" />
                <Button Grid.Column="2" Content="Store" Command="{Binding SaveSecretCommand}" />
                <Button Grid.Column="3" Content="Clear" Command="{Binding ClearSecretCommand}" />
              </Grid>

              <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource Text3Brush}"
                         Text="Protected at rest with DPAPI (CurrentUser), per environment. The stored secret is never displayed or logged." />
            </StackPanel>
          </TabItem>

          <!-- Data Integrator: delegated token (ROPC service account or interactive), never app-only. -->
          <TabItem Header="Data Integrator">
            <StackPanel Spacing="12" Margin="0,12,0,0">
              <Border Background="{StaticResource InfoBgBrush}" BorderBrush="{StaticResource InfoBrush}"
                      BorderThickness="1" CornerRadius="8" Padding="12,8">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Text1Brush}"
                           Text="Used by Dual-Write Operations &amp; Compare. The gateway requires a delegated Data Integrator token — app-only is not available." />
              </Border>

              <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto" RowSpacing="6">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Mode" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                <ComboBox Grid.Row="0" Grid.Column="1" Width="220" HorizontalAlignment="Left"
                          ItemsSource="{Binding DiModes}" SelectedItem="{Binding DraftDiMode, Mode=TwoWay}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:DiAuthMode">
                      <TextBlock Text="{Binding Converter={x:Static conv:DiAuthModeLabelConverter.Instance}}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Client ID" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DraftDiClientId, Mode=TwoWay}"
                         PlaceholderText="Data Integrator app (client) ID" FontFamily="Cascadia Code,Consolas,monospace" />
              </Grid>

              <!-- ROPC service account -->
              <StackPanel Spacing="8" IsVisible="{Binding IsRopc}">
                <Border Background="{StaticResource WarnBgBrush}" BorderBrush="{StaticResource WarnBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12,8">
                  <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Text1Brush}"
                             Text="Use a non-MFA service account — ROPC fails under MFA (AADSTS50076). The password is DPAPI-encrypted at rest." />
                </Border>
                <Grid ColumnDefinitions="130,*,Auto,Auto" ColumnSpacing="8">
                  <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Secret" Foreground="{StaticResource Text2Brush}" VerticalAlignment="Center" />
                    <Border IsVisible="{Binding HasDiSecret}" Background="{StaticResource OkBgBrush}"
                            CornerRadius="999" Padding="6,1" VerticalAlignment="Center">
                      <TextBlock Text="set" FontSize="10" Foreground="{StaticResource OkBrush}" />
                    </Border>
                  </StackPanel>
                  <TextBox Grid.Column="1" Text="{Binding DiSecretInput, Mode=TwoWay}" PasswordChar="●"
                           PlaceholderText="Service-account password" FontFamily="Cascadia Code,Consolas,monospace" />
                  <Button Grid.Column="2" Content="Store" Command="{Binding SaveDiSecretCommand}" />
                  <Button Grid.Column="3" Content="Clear" Command="{Binding ClearDiSecretCommand}" />
                </Grid>
              </StackPanel>

              <!-- Interactive sign-in -->
              <StackPanel Spacing="8" IsVisible="{Binding IsInteractive}">
                <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource Text3Brush}"
                           Text="Captures a delegated token + refresh token via an interactive sign-in (WebView2). Renews silently after the first sign-in." />
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Content="Sign in" Command="{Binding SignInCommand}"
                          Background="{StaticResource AccentBrush}" Foreground="{StaticResource OnAccentBrush}" />
                  <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsSigningIn}" Width="90" Height="4"
                               VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>

              <TextBlock Text="{Binding DiStatus}" FontSize="12" Foreground="{StaticResource Text2Brush}"
                         IsVisible="{Binding DiStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </TabItem>
        </TabControl>

        <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{StaticResource Text2Brush}" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
