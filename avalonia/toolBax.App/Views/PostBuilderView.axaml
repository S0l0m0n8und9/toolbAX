<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ToolBax.App.ViewModels"
             xmlns:models="using:ToolBax.Core.Models"
             x:Class="ToolBax.App.Views.PostBuilderView"
             x:DataType="vm:PostBuilderViewModel">

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" Margin="20,16">

    <TextBlock Grid.Row="0" Text="POST Builder" FontSize="24" FontWeight="SemiBold"
               Foreground="{StaticResource Text0Brush}" />

    <!-- Method + path + options + send -->
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" Margin="0,12,0,6" ColumnSpacing="8">
      <ComboBox Grid.Column="0" Width="120" ItemsSource="{Binding Methods}"
                SelectedItem="{Binding Method, Mode=TwoWay}" />
      <TextBox Grid.Column="1" Text="{Binding Path, Mode=TwoWay}"
               FontFamily="Cascadia Code,Consolas,monospace" />
      <CheckBox Grid.Column="2" Content="Build from fields" VerticalAlignment="Center"
                IsChecked="{Binding UseFieldGrid, Mode=TwoWay}"
                ToolTip.Tip="Compose the body from the entity's fields instead of raw JSON" />
      <CheckBox Grid.Column="3" Content="cross-company" VerticalAlignment="Center"
                IsChecked="{Binding CrossCompany, Mode=TwoWay}" />
      <Button Grid.Column="4" Content="Copy URL" Command="{Binding CopyUrlCommand}" />
      <!-- SendCommand (AsyncRelayCommand) disables itself while running, so no explicit IsEnabled. -->
      <Button Grid.Column="5" x:Name="SendButton" Content="Send" Command="{Binding SendCommand}"
              Background="{StaticResource AccentBrush}" Foreground="{StaticResource OnAccentBrush}" />
      <!-- Cancellation belongs to the accepted send/readback; rejected direct calls cannot replace it. -->
      <Button Grid.Column="6" Content="Cancel" Command="{Binding SendCancelCommand}" IsVisible="{Binding IsBusy}"
              ToolTip.Tip="Cancel the in-flight send" />
    </Grid>

    <!-- If-Match conditional write — only relevant for PATCH/DELETE -->
    <StackPanel Grid.Row="2" Orientation="Vertical" Spacing="3" Margin="0,0,0,6"
                VerticalAlignment="Center" IsVisible="{Binding ShowIfMatch}">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <CheckBox Content="If-Match" VerticalAlignment="Center" IsChecked="{Binding UseIfMatch, Mode=TwoWay}"
                  ToolTip.Tip="Send a conditional If-Match header on PATCH or DELETE." />
        <TextBox Width="220" Text="{Binding IfMatch, Mode=TwoWay}" IsEnabled="{Binding UseIfMatch}"
                 FontFamily="Cascadia Code,Consolas,monospace"
                 ToolTip.Tip="&quot;*&quot; (any version) or a specific ETag" />
      </StackPanel>
      <TextBlock Text="When enabled, * matches any existing version. Use the record’s ETag to request a version check where supported."
                 TextWrapping="Wrap" FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource Text2Brush}" />
    </StackPanel>

    <!-- Computed request URL preview -->
    <TextBox Grid.Row="3" Text="{Binding RequestUrl, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,6"
             FontFamily="Cascadia Code,Consolas,monospace" FontSize="12" Foreground="{StaticResource Text2Brush}" />

    <!-- The captured write and later GET observation are independent, measured rows. -->
    <Border Grid.Row="4" x:Name="WriteReceiptPanel" IsVisible="{Binding HasWriteReceipt}" Margin="0,6,0,8"
            Padding="10" CornerRadius="6" Background="{StaticResource WarnBgBrush}" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1">
      <StackPanel Spacing="6">
        <TextBlock Text="Last write evidence — cancellation does not roll back a write" FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" />
        <ScrollViewer MaxHeight="90"><TextBlock x:Name="ReceiptText" Text="{Binding WriteReceiptText}" TextWrapping="Wrap" Foreground="{StaticResource Text1Brush}" /></ScrollViewer>
        <Button x:Name="ReconcileButton" Content="Read current state" Command="{Binding ReconcileCommand}" HorizontalAlignment="Left" />
        <TextBlock Text="{Binding ReconcileReason}" TextWrapping="Wrap" Foreground="{StaticResource Text2Brush}"
                   IsVisible="{Binding ReconcileReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <Border x:Name="ReadbackPanel" IsVisible="{Binding ReadbackText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Padding="8" Background="{StaticResource Layer1Brush}">
          <ScrollViewer MaxHeight="90"><TextBlock x:Name="ReadbackText" Text="{Binding ReadbackText}" TextWrapping="Wrap" Foreground="{StaticResource Text1Brush}" /></ScrollViewer>
        </Border>
      </StackPanel>
    </Border>
    <!-- Request | response -->
    <Grid Grid.Row="5" ColumnDefinitions="*,*" ColumnSpacing="12">
      <DockPanel Grid.Column="0">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
          <TextBlock Grid.Column="0" Text="REQUEST" FontSize="11" VerticalAlignment="Center"
                     Foreground="{StaticResource Text3Brush}" />
          <Button Grid.Column="1" Content="Copy payload" FontSize="11" Padding="6,2"
                  Command="{Binding CopyPayloadCommand}" />
        </Grid>

        <!-- Entity-catalogue/field load failure — shown in BOTH modes (raw mode hides the picker entirely,
             but an Initialize/EnsureFields failure is still worth knowing about there). Kept independent of
             the payload-issues panel below, which only applies in grid mode. -->
        <TextBlock DockPanel.Dock="Top" Text="{Binding LoadError}"
                   IsVisible="{Binding LoadError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Foreground="{StaticResource ErrBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,6" />

        <!-- Entity picker (field-grid mode) -->
        <StackPanel DockPanel.Dock="Top" IsVisible="{Binding UseFieldGrid}" Spacing="6" Margin="0,0,0,6">
          <TextBox Text="{Binding EntitySearch, Mode=TwoWay}" PlaceholderText="Search entities…" />
          <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding FilteredEntities}"
                    SelectedItem="{Binding SelectedEntity, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="models:EntitySet">
                <TextBlock Text="{Binding Name}" FontFamily="Cascadia Code,Consolas,monospace" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="{Binding GridSummary}" FontSize="11" Foreground="{StaticResource Text3Brush}"
                     FontFamily="Cascadia Code,Consolas,monospace"
                     IsVisible="{Binding GridSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>

        <!-- Validation issues (field-grid mode). These block Send, so error styling; a concise count
             header sits above the full detail, which is height-capped + scrollable so a many-mandatory
             entity can't turn it into a wall. -->
        <Border DockPanel.Dock="Bottom" IsVisible="{Binding HasPayloadIssues}" Margin="0,6,0,0"
                Background="{StaticResource ErrBgBrush}" BorderBrush="{StaticResource ErrBrush}"
                BorderThickness="1" CornerRadius="6" Padding="8,6">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{Binding PayloadIssueSummary}" Margin="0,0,0,4"
                       FontSize="{StaticResource FontSizeCaption}" FontWeight="SemiBold"
                       Foreground="{StaticResource ErrBrush}" />
            <ScrollViewer MaxHeight="64" VerticalScrollBarVisibility="Auto">
              <TextBlock Text="{Binding PayloadIssues}" TextWrapping="Wrap"
                         FontSize="{StaticResource FontSizeCaption}" Foreground="{StaticResource Text1Brush}" />
            </ScrollViewer>
          </DockPanel>
        </Border>

        <!-- Generated payload preview (field-grid mode) -->
        <TextBox DockPanel.Dock="Bottom" IsVisible="{Binding UseFieldGrid}" Height="120" Margin="0,6,0,0"
                 Text="{Binding RequestBody}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                 FontFamily="Cascadia Code,Consolas,monospace" FontSize="12"
                 VerticalContentAlignment="Top" />

        <!-- Field grid (grid mode) OR raw JSON editor (raw mode) -->
        <Grid>
          <DataGrid IsVisible="{Binding UseFieldGrid}" ItemsSource="{Binding Fields}"
                    AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                    Background="{StaticResource Layer1Brush}">
            <DataGrid.Columns>
              <!-- Header carries the omit/clear distinction the checkbox means on a PATCH: the tip lives on a
                   TextBlock header (DataGridColumn isn't a Control, so ToolTip.Tip can't attach to it). -->
              <DataGridCheckBoxColumn Binding="{Binding Include}" Width="48">
                <DataGridCheckBoxColumn.Header>
                  <TextBlock Text="Incl"
                             ToolTip.Tip="On PATCH: included + blank clears the field (sends null); unchecked leaves it alone." />
                </DataGridCheckBoxColumn.Header>
              </DataGridCheckBoxColumn>
              <DataGridTextColumn Header="Field" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
              <DataGridTextColumn Header="Type" Binding="{Binding Type}" IsReadOnly="True" Width="Auto" />
              <DataGridCheckBoxColumn Header="Req" Binding="{Binding Mandatory}" IsReadOnly="True" Width="44" />
              <!-- Value cell shows the editor that fits the field: dropdown (enum), checkbox (bool),
                   otherwise a text box. All three are inline (always editable) and visibility-switched. -->
              <DataGridTemplateColumn Header="Value" Width="2*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:PostFieldRow">
                    <Panel VerticalAlignment="Center">
                      <TextBox IsVisible="{Binding IsText}" Text="{Binding Value, Mode=TwoWay}"
                               FontFamily="Cascadia Code,Consolas,monospace" />
                      <CheckBox IsVisible="{Binding IsBool}" IsThreeState="True"
                                IsChecked="{Binding BoolValue, Mode=TwoWay}" />
                      <ComboBox IsVisible="{Binding IsEnum}" HorizontalAlignment="Stretch"
                                ItemsSource="{Binding EnumMembers}" SelectedItem="{Binding Value, Mode=TwoWay}" />
                    </Panel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <TextBox IsVisible="{Binding !UseFieldGrid}" Text="{Binding RequestBody, Mode=TwoWay}"
                   AcceptsReturn="True" TextWrapping="NoWrap"
                   FontFamily="Cascadia Code,Consolas,monospace"
                   VerticalContentAlignment="Top" />
        </Grid>
      </DockPanel>

      <DockPanel Grid.Column="1">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,4">
          <TextBlock Grid.Column="0" TextWrapping="Wrap" x:Name="StatusText" Text="{Binding StatusText}" FontSize="11.5" VerticalAlignment="Center"
                     FontFamily="Cascadia Code,Consolas,monospace" Foreground="{StaticResource Text2Brush}" />
          <Border Grid.Column="1" IsVisible="{Binding SendSucceeded}" Background="{StaticResource OkBgBrush}"
                  CornerRadius="999" Padding="8,1" VerticalAlignment="Center">
            <TextBlock Text="{Binding StatusBadge}" FontSize="11" Foreground="{StaticResource OkBrush}" />
          </Border>
        </Grid>
        <!-- Response headers (ETag, OData-EntityId, Location, …) above the body -->
        <Border DockPanel.Dock="Top" IsVisible="{Binding HasResponseHeaders}" Margin="0,0,0,6"
                Background="{StaticResource Layer1Brush}" BorderBrush="{StaticResource StrokeBrush}"
                BorderThickness="1" CornerRadius="4" MaxHeight="120">
          <ScrollViewer>
            <SelectableTextBlock Text="{Binding ResponseHeaders}" Margin="10,6"
                                 FontFamily="Cascadia Code,Consolas,monospace" FontSize="11"
                                 TextWrapping="Wrap" Foreground="{StaticResource Text2Brush}" />
          </ScrollViewer>
        </Border>
        <Border Background="{StaticResource Layer1Brush}"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="4">
          <ScrollViewer>
            <TextBlock Text="{Binding ResponseBody}" Margin="10"
                       FontFamily="Cascadia Code,Consolas,monospace" FontSize="12"
                       TextWrapping="Wrap" Foreground="{StaticResource Text1Brush}" />
          </ScrollViewer>
        </Border>
      </DockPanel>
    </Grid>
  </Grid>
</UserControl>
