<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ToolBax.App.ViewModels"
             x:Class="ToolBax.App.Views.PostBuilderView"
             x:DataType="vm:PostBuilderViewModel">

  <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="20,16">

    <TextBlock Grid.Row="0" Text="POST Builder" FontSize="24" FontWeight="SemiBold"
               Foreground="{StaticResource Text0Brush}" />

    <!-- Method + path + options + send -->
    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,12,0,6" ColumnSpacing="8">
      <ComboBox Grid.Column="0" Width="120" ItemsSource="{Binding Methods}"
                SelectedItem="{Binding Method, Mode=TwoWay}" />
      <TextBox Grid.Column="1" Text="{Binding Path, Mode=TwoWay}"
               FontFamily="Cascadia Code,Consolas,monospace" />
      <CheckBox Grid.Column="2" Content="cross-company" VerticalAlignment="Center"
                IsChecked="{Binding CrossCompany, Mode=TwoWay}" />
      <Button Grid.Column="3" Content="Copy URL" Command="{Binding CopyUrlCommand}" />
      <!-- SendCommand (AsyncRelayCommand) disables itself while running, so no explicit IsEnabled. -->
      <Button Grid.Column="4" x:Name="SendButton" Content="Send" Command="{Binding SendCommand}"
              Background="{StaticResource AccentBrush}" Foreground="{StaticResource OnAccentBrush}" />
    </Grid>

    <!-- Computed request URL preview -->
    <TextBox Grid.Row="2" Text="{Binding RequestUrl, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,6"
             FontFamily="Cascadia Code,Consolas,monospace" FontSize="12" Foreground="{StaticResource Text2Brush}" />

    <!-- Request | response -->
    <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="12">
      <DockPanel Grid.Column="0">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
          <TextBlock Grid.Column="0" Text="REQUEST" FontSize="10" VerticalAlignment="Center"
                     Foreground="{StaticResource Text3Brush}" />
          <Button Grid.Column="1" Content="Copy payload" FontSize="11" Padding="6,2"
                  Command="{Binding CopyPayloadCommand}" />
        </Grid>
        <TextBox Text="{Binding RequestBody, Mode=TwoWay}"
                 AcceptsReturn="True" TextWrapping="NoWrap"
                 FontFamily="Cascadia Code,Consolas,monospace"
                 VerticalContentAlignment="Top" />
      </DockPanel>

      <DockPanel Grid.Column="1">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
          <TextBlock x:Name="StatusText" Text="{Binding StatusText}" FontSize="11.5" VerticalAlignment="Center"
                     FontFamily="Cascadia Code,Consolas,monospace" Foreground="{StaticResource Text2Brush}" />
          <Border IsVisible="{Binding SendSucceeded}" Background="{StaticResource OkBgBrush}"
                  CornerRadius="999" Padding="8,1" VerticalAlignment="Center">
            <TextBlock Text="{Binding StatusBadge}" FontSize="10.5" Foreground="{StaticResource OkBrush}" />
          </Border>
        </StackPanel>
        <Border Background="{StaticResource Layer1Brush}"
                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="4">
          <ScrollViewer>
            <TextBlock Text="{Binding ResponseBody}" Margin="10"
                       FontFamily="Cascadia Code,Consolas,monospace" FontSize="12"
                       TextWrapping="Wrap" Foreground="{StaticResource Text1Brush}" />
          </ScrollViewer>
        </Border>
      </DockPanel>
    </Grid>
  </Grid>
</UserControl>
