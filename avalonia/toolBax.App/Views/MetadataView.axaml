<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ToolBax.App.ViewModels"
             xmlns:models="using:ToolBax.Core.Models"
             x:Class="ToolBax.App.Views.MetadataView"
             x:DataType="vm:MetadataViewModel">

  <Grid ColumnDefinitions="300,*">

    <!-- Master: entity sets -->
    <Border Grid.Column="0" Background="{StaticResource MicaBrush}"
            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" Text="{Binding LoadError}"
                   IsVisible="{Binding LoadError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Foreground="{StaticResource ErrBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8" />
        <TextBox DockPanel.Dock="Top" Text="{Binding Search, Mode=TwoWay}"
                 PlaceholderText="Search entities…" Margin="0,0,0,8" />
        <ListBox x:Name="EntityList"
                 ItemsSource="{Binding Filtered}"
                 SelectedItem="{Binding Selected, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:EntitySet">
              <StackPanel Spacing="1" Margin="0,2">
                <TextBlock Text="{Binding Name}" FontSize="13"
                           FontFamily="Cascadia Code,Consolas,monospace" Foreground="{StaticResource Text0Brush}" />
                <TextBlock FontSize="11" Foreground="{StaticResource Text3Brush}">
                  <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0} props · {1}">
                      <Binding Path="FieldCount" />
                      <Binding Path="Module" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Detail -->
    <Grid Grid.Column="1" Margin="24,16" RowDefinitions="Auto,Auto,*"
          IsVisible="{Binding HasSelection}">

      <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
        <TextBlock FontSize="11" Foreground="{StaticResource Text3Brush}"
                   Text="{Binding Selected.Module, StringFormat='ENTITY · {0}'}" />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock x:Name="DetailTitle" Text="{Binding Selected.Name}"
                     FontSize="24" FontWeight="SemiBold"
                     FontFamily="Cascadia Code,Consolas,monospace" Foreground="{StaticResource Text0Brush}" />
          <Border IsVisible="{Binding Selected.CompanyAware}" VerticalAlignment="Center"
                  Background="{StaticResource Layer3Brush}" CornerRadius="999" Padding="8,2">
            <TextBlock Text="company-aware" FontSize="11" Foreground="{StaticResource Text2Brush}" />
          </Border>
        </StackPanel>
        <TextBlock FontSize="12" Foreground="{StaticResource Text2Brush}">
          <TextBlock.Text>
            <MultiBinding StringFormat="{}pk: {0} · {1} properties">
              <Binding Path="Selected.Pk" />
              <Binding Path="Selected.FieldCount" />
            </MultiBinding>
          </TextBlock.Text>
        </TextBlock>
      </StackPanel>

      <!-- Property search (when cached) -->
      <TextBox Grid.Row="1" IsVisible="{Binding IsCached}" Width="280" HorizontalAlignment="Left"
               Margin="0,0,0,8" Text="{Binding FieldSearch, Mode=TwoWay}"
               PlaceholderText="Search properties…" />

      <!-- Property table when cached -->
      <DataGrid Grid.Row="2" x:Name="FieldsGrid"
                IsVisible="{Binding IsCached}"
                ItemsSource="{Binding FilteredFields}" IsReadOnly="True"
                GridLinesVisibility="Horizontal" Background="{StaticResource Layer1Brush}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Property" Binding="{Binding Name}" Width="2*" />
          <DataGridTextColumn Header="Type" Binding="{Binding TypeDisplay}" Width="*" />
          <DataGridTemplateColumn Header="Key" Width="Auto">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="models:EntityField">
                <Border IsVisible="{Binding IsKey}" Background="{StaticResource WarnBgBrush}" CornerRadius="999"
                        Padding="6,1" Margin="4,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                  <TextBlock Text="key" FontSize="11" Foreground="{StaticResource WarnBrush}" />
                </Border>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Mandatory" Binding="{Binding Mandatory}" Width="Auto" />
          <DataGridTextColumn Header="Nullable" Binding="{Binding Nullable}" Width="Auto" />
          <DataGridTextColumn Header="Max Len" Binding="{Binding MaxLengthDisplay}" Width="Auto" />
          <DataGridTextColumn Header="Prec/Scale" Binding="{Binding PrecisionScale}" Width="Auto" />
          <DataGridTextColumn Header="Range" Binding="{Binding Range}" Width="*" />
        </DataGrid.Columns>
      </DataGrid>

      <!-- Not-cached hint -->
      <Border Grid.Row="2" VerticalAlignment="Top"
              IsVisible="{Binding !IsCached}"
              Background="{StaticResource InfoBgBrush}"
              BorderBrush="{StaticResource InfoBrush}" BorderThickness="1" CornerRadius="8"
              Padding="12,8">
        <TextBlock Text="{Binding NotCachedMessage}" TextWrapping="Wrap" Foreground="{StaticResource Text1Brush}" />
      </Border>
    </Grid>
  </Grid>
</UserControl>
