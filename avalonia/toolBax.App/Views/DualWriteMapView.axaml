<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ToolBax.App.ViewModels"
             xmlns:models="using:ToolBax.Core.Models"
             x:Class="ToolBax.App.Views.DualWriteMapView"
             x:DataType="vm:DualWriteMapViewModel">

  <Grid ColumnDefinitions="340,*">

    <!-- Master -->
    <Border Grid.Column="0" Background="{StaticResource MicaBrush}"
            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="10">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="2,2,0,8">
          <TextBlock Grid.Column="0" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"
                     Text="{Binding Maps.Count, StringFormat='Table maps · {0}'}" />
          <Button Grid.Column="1" Content="Refresh" Command="{Binding ReloadMapsCommand}"
                  IsEnabled="{Binding !IsLoading}" />
        </Grid>
        <ComboBox DockPanel.Dock="Top" Margin="0,0,0,6" HorizontalAlignment="Stretch"
                  ItemsSource="{Binding Publishers}" SelectedItem="{Binding SelectedPublisher, Mode=TwoWay}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="models:DwPublisher">
              <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <ComboBox DockPanel.Dock="Top" Margin="0,0,0,8" HorizontalAlignment="Stretch"
                  ItemsSource="{Binding Solutions}" SelectedItem="{Binding SelectedSolution, Mode=TwoWay}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="models:DwSolution">
              <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBox DockPanel.Dock="Top" Text="{Binding Search, Mode=TwoWay}"
                 PlaceholderText="Filter maps…" Margin="0,0,0,8" />
        <TextBlock DockPanel.Dock="Top" Text="Loading maps…" Margin="2,4" FontSize="12"
                   Foreground="{StaticResource Text3Brush}" IsVisible="{Binding IsLoading}" />
        <TextBlock DockPanel.Dock="Top" Margin="2,4" TextWrapping="Wrap" FontSize="12"
                   Foreground="{StaticResource Text3Brush}" IsVisible="{Binding ShowEmptyState}"
                   Text="No dual-write maps found in this environment." />
        <ListBox x:Name="MapList"
                 ItemsSource="{Binding Filtered}"
                 SelectedItem="{Binding SelectedMap, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:DwMapRecord">
              <StackPanel Spacing="2" Margin="0,3">
                <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{StaticResource Text0Brush}"
                           TextTrimming="CharacterEllipsis" />
                <Grid ColumnDefinitions="*,Auto,*">
                  <TextBlock Grid.Column="0" Text="{Binding PrimarySource}" FontSize="11"
                             FontFamily="Cascadia Code,Consolas,monospace"
                             Foreground="{StaticResource Text2Brush}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="↔" FontSize="11" Margin="5,0"
                             Foreground="{StaticResource AccentBrush}" />
                  <TextBlock Grid.Column="2" Text="{Binding PrimaryDestination}" FontSize="11"
                             FontFamily="Cascadia Code,Consolas,monospace"
                             Foreground="{StaticResource Text2Brush}" TextTrimming="CharacterEllipsis"
                             TextAlignment="Right" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding VersionLabel}" FontSize="10.5"
                             FontFamily="Cascadia Code,Consolas,monospace" Foreground="{StaticResource Text3Brush}" />
                  <TextBlock Text="{Binding State}" FontSize="10.5" Foreground="{StaticResource Text3Brush}"
                             IsVisible="{Binding HasState}" />
                </StackPanel>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Detail -->
    <Grid Grid.Column="1" Margin="24,16,24,0">

      <!-- Load / auth error -->
      <Border VerticalAlignment="Top" IsVisible="{Binding HasLoadError}"
              Background="{StaticResource ErrBgBrush}" BorderBrush="{StaticResource ErrBrush}"
              BorderThickness="1" CornerRadius="8" Padding="12,8">
        <TextBlock Text="{Binding LoadError}" TextWrapping="Wrap" Foreground="{StaticResource Text0Brush}" />
      </Border>

      <!-- No selection (and no error / empty / loading) -->
      <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center"
                 Foreground="{StaticResource Text3Brush}" Text="Select a dual-write map to inspect it."
                 IsVisible="{Binding ShowSelectPrompt}" />

      <!-- Detail content -->
      <Grid RowDefinitions="Auto,*" IsVisible="{Binding HasSelection}">

        <StackPanel Grid.Row="0" Spacing="10">

          <!-- Read-only inspector banner -->
          <Border Background="{StaticResource InfoBgBrush}" BorderBrush="{StaticResource InfoBrush}"
                  BorderThickness="1" CornerRadius="8" Padding="12,8">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Text1Brush}"
                       Text="Read-only inspector. To start, stop, pause or sync a map, open Dual-Write Operations." />
          </Border>

          <!-- Eyebrow + badges -->
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="DUAL-WRITE MAP" FontSize="11" VerticalAlignment="Center"
                       Foreground="{StaticResource Text3Brush}" />
            <Border Background="{StaticResource Layer3Brush}" CornerRadius="999" Padding="8,2"
                    IsVisible="{Binding DetailMap.HasState}">
              <TextBlock Text="{Binding DetailMap.State}" FontSize="10.5" Foreground="{StaticResource Text1Brush}" />
            </Border>
            <Border Background="{StaticResource Layer3Brush}" CornerRadius="999" Padding="8,2">
              <TextBlock Text="{Binding DetailMap.Status}" FontSize="10.5" Foreground="{StaticResource Text1Brush}" />
            </Border>
            <Border Background="{StaticResource Layer3Brush}" CornerRadius="999" Padding="8,2">
              <TextBlock Text="{Binding DetailMap.VersionLabel}" FontSize="10.5" Foreground="{StaticResource Text1Brush}" />
            </Border>
          </StackPanel>

          <!-- Title + export -->
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="{Binding DetailMap.Title}" FontSize="22" VerticalAlignment="Center"
                       Foreground="{StaticResource Text0Brush}" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <TextBlock Text="{Binding ExportStatus}" FontSize="12" VerticalAlignment="Center"
                         Foreground="{StaticResource Text3Brush}" TextTrimming="CharacterEllipsis" MaxWidth="280"
                         IsVisible="{Binding ExportStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <Button Content="Export Markdown" Command="{Binding ExportMarkdownCommand}" />
            </StackPanel>
          </Grid>

          <!-- Source ↔ destination + metadata grid -->
          <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="{Binding DetailMap.PrimarySource}" FontSize="14"
                       FontFamily="Cascadia Code,Consolas,monospace" Foreground="{StaticResource Text1Brush}" />
            <TextBlock Text="↔" FontSize="16" Foreground="{StaticResource AccentBrush}" />
            <TextBlock Text="{Binding DetailMap.PrimaryDestination}" FontSize="14"
                       FontFamily="Cascadia Code,Consolas,monospace" Foreground="{StaticResource Text2Brush}" />
          </StackPanel>

          <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto" Margin="0,2,0,0">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="LEGS" FontSize="10" Foreground="{StaticResource Text3Brush}" Margin="0,0,24,0" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding DetailMap.LegCount}" FontSize="15"
                       FontFamily="Cascadia Code,Consolas,monospace" Foreground="{StaticResource Text0Brush}" Margin="0,0,24,0" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="FIELDS" FontSize="10" Foreground="{StaticResource Text3Brush}" Margin="0,0,24,0" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DetailMap.FieldCount}" FontSize="15"
                       FontFamily="Cascadia Code,Consolas,monospace" Foreground="{StaticResource Text0Brush}" Margin="0,0,24,0" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="OWNER" FontSize="10" Foreground="{StaticResource Text3Brush}" Margin="0,0,24,0" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding DetailMap.Owner}" FontSize="13"
                       Foreground="{StaticResource Text1Brush}" Margin="0,0,24,0" />
            <TextBlock Grid.Row="0" Grid.Column="3" Text="MODIFIED" FontSize="10" Foreground="{StaticResource Text3Brush}" />
            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding DetailMap.ModifiedOnLabel}" FontSize="13"
                       Foreground="{StaticResource Text1Brush}" />
          </Grid>
        </StackPanel>

        <!-- Pivot tabs -->
        <TabControl Grid.Row="1" Margin="0,12,0,0">
          <TabItem Header="Legs">
            <DataGrid x:Name="LegsGrid" ItemsSource="{Binding DetailMap.Legs}" IsReadOnly="True"
                      AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                      Background="{StaticResource Layer1Brush}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Source (F&amp;O)" Binding="{Binding SourceSchema}" Width="2*" />
                <DataGridTextColumn Header="Destination (Dataverse)" Binding="{Binding DestinationSchema}" Width="2*" />
                <DataGridTextColumn Header="Source env" Binding="{Binding SourceEnvironmentType}" Width="Auto" />
                <DataGridTextColumn Header="Dest env" Binding="{Binding DestinationEnvironmentType}" Width="Auto" />
                <DataGridTextColumn Header="Fields" Binding="{Binding FieldMappings}" Width="Auto" />
                <DataGridTextColumn Header="Source filter (X++)" Binding="{Binding SourceFilter}" Width="3*" />
                <DataGridTextColumn Header="Source filter (OData)" Binding="{Binding SourceFilterOData}" Width="3*" />
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>

          <TabItem Header="Field mappings">
            <DataGrid x:Name="FieldsGrid" ItemsSource="{Binding DetailMap.Fields}" IsReadOnly="True"
                      AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                      Background="{StaticResource Layer1Brush}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Source field" Binding="{Binding SourceField}" Width="2*" />
                <DataGridTextColumn Header="Destination field" Binding="{Binding DestinationField}" Width="2*" />
                <DataGridTextColumn Header="Direction" Binding="{Binding SyncDirection}" Width="Auto" />
                <DataGridTextColumn Header="Lookup entity" Binding="{Binding DestinationLookupEntity}" Width="*" />
                <DataGridTextColumn Header="Transforms" Binding="{Binding ValueTransforms}" Width="Auto" />
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>

          <TabItem Header="Value transforms">
            <Grid>
              <DataGrid x:Name="TransformsGrid" ItemsSource="{Binding DetailMap.ValueTransforms}" IsReadOnly="True"
                        AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                        Background="{StaticResource Layer1Brush}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Source field" Binding="{Binding SourceField}" Width="*" />
                  <DataGridTextColumn Header="Destination field" Binding="{Binding DestinationField}" Width="*" />
                  <DataGridTextColumn Header="Type" Binding="{Binding TransformType}" Width="Auto" />
                  <DataGridTextColumn Header="Default" Binding="{Binding DefaultValue}" Width="Auto" />
                  <DataGridTextColumn Header="Value map" Binding="{Binding ValueMap}" Width="2*" />
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </TabItem>

          <TabItem Header="Summary">
            <DataGrid x:Name="SummaryGrid" ItemsSource="{Binding DetailMap.SummaryRows}" IsReadOnly="True"
                      AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                      Background="{StaticResource Layer1Brush}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="*" />
                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="2*" />
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>

          <TabItem Header="Row counts">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
                <Button Content="Count rows" Command="{Binding CountAllRowsCommand}" />
                <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Text3Brush}"
                           Text="Compares F&amp;O and Dataverse (CE) row counts per leg. Edit the F&amp;O entity if the auto-guess is wrong." />
              </StackPanel>
              <DataGrid x:Name="CountsGrid" ItemsSource="{Binding CountRows}" IsReadOnly="True"
                        AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                        Background="{StaticResource Layer1Brush}">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="F&amp;O entity" Width="2*">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate x:DataType="vm:MapLegCountRow">
                        <TextBox Text="{Binding FoEntity, Mode=TwoWay}" BorderThickness="0"
                                 Background="Transparent" VerticalAlignment="Center" />
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="F&amp;O rows" Binding="{Binding FoCountLabel}" Width="Auto" />
                  <DataGridTextColumn Header="Destination (CE)" Binding="{Binding DestinationSchema}" Width="2*" />
                  <DataGridTextColumn Header="CE rows" Binding="{Binding CeCountLabel}" Width="Auto" />
                  <DataGridTextColumn Header="Compare" Binding="{Binding ComparisonLabel}" Width="Auto" />
                  <DataGridTextColumn Header="F&amp;O status" Binding="{Binding FoStatus}" Width="*" />
                  <DataGridTextColumn Header="CE status" Binding="{Binding CeStatus}" Width="*" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </TabItem>

          <TabItem Header="Properties">
            <DataGrid x:Name="PropertiesGrid" ItemsSource="{Binding DetailMap.Properties}" IsReadOnly="True"
                      AutoGenerateColumns="False" GridLinesVisibility="Horizontal"
                      Background="{StaticResource Layer1Brush}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="*" />
                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="Auto" />
                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="2*" />
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>

          <TabItem Header="Raw mapping">
            <ScrollViewer>
              <TextBox Text="{Binding DetailMap.RawMapping, Mode=OneWay}" IsReadOnly="True"
                       AcceptsReturn="True" TextWrapping="Wrap" FontSize="12"
                       FontFamily="Cascadia Code,Consolas,monospace" BorderThickness="0"
                       Background="{StaticResource Layer1Brush}" />
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
