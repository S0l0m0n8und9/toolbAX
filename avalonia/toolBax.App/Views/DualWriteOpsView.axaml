<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ToolBax.App.ViewModels"
             x:Class="ToolBax.App.Views.DualWriteOpsView"
             x:DataType="vm:DualWriteOpsViewModel">

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="20,16">

    <!-- Title + connect -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <TextBlock Grid.Column="0" Text="Dual-Write Operations" VerticalAlignment="Center"
                 FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Text0Brush}" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" FontSize="11.5"
                   Foreground="{StaticResource Text2Brush}" />
        <Button Content="Connect" Command="{Binding LoadCommand}"
                Background="{StaticResource AccentBrush}" Foreground="{StaticResource OnAccentBrush}" />
      </StackPanel>
    </Grid>

    <!-- Live-environment banner (once connected) -->
    <Border Grid.Row="1" Margin="0,12,0,0" IsVisible="{Binding IsConnected}"
            Background="{StaticResource WarnBgBrush}"
            BorderBrush="{StaticResource WarnBrush}" BorderThickness="1" CornerRadius="8"
            Padding="12,8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="⚠" Foreground="{StaticResource WarnBrush}" VerticalAlignment="Center" />
        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
          <Run Text="Live environment." FontWeight="SemiBold" Foreground="{StaticResource Text0Brush}" />
          <Run Text="{Binding ConnectionName}" Foreground="{StaticResource Text1Brush}" />
        </TextBlock>
      </StackPanel>
    </Border>

    <!-- Connect/load error -->
    <Border Grid.Row="2" Margin="0,12,0,0"
            IsVisible="{Binding LoadError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
            Background="{StaticResource ErrBgBrush}" BorderBrush="{StaticResource ErrBrush}"
            BorderThickness="1" CornerRadius="8" Padding="12,8">
      <TextBlock Text="{Binding LoadError}" TextWrapping="Wrap" Foreground="{StaticResource Text1Brush}" />
    </Border>

    <!-- Empty hint -->
    <TextBlock Grid.Row="3" Margin="2,16,0,0" IsVisible="{Binding !IsConnected}"
               Text="Connect to the dual-write gateway to list this environment's maps."
               Foreground="{StaticResource Text3Brush}" TextWrapping="Wrap" />

    <!-- Maps grid -->
    <DataGrid Grid.Row="4" x:Name="MapsGrid" Margin="0,12,0,0"
              IsVisible="{Binding HasMaps}"
              ItemsSource="{Binding Maps}" IsReadOnly="False"
              CanUserReorderColumns="False" CanUserResizeColumns="True"
              GridLinesVisibility="Horizontal" Background="{StaticResource Layer1Brush}">
      <DataGrid.Columns>
        <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected}" Width="40" />
        <DataGridTextColumn Header="Map" Binding="{Binding Name}" Width="2*" IsReadOnly="True" />
        <DataGridTextColumn Header="CE entity" Binding="{Binding CeEntity}" Width="*" IsReadOnly="True"
                            FontFamily="Cascadia Code,Consolas,monospace" />
        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="Auto" IsReadOnly="True" />
        <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="*" IsReadOnly="True" />
        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="*" IsReadOnly="True" />
      </DataGrid.Columns>
    </DataGrid>
  </Grid>
</UserControl>
