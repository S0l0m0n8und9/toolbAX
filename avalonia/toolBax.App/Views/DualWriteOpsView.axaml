<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ToolBax.App.ViewModels"
             xmlns:conv="using:ToolBax.App.Converters"
             x:Class="ToolBax.App.Views.DualWriteOpsView"
             x:DataType="vm:DualWriteOpsViewModel">

  <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" Margin="20,16">

    <!-- Title + connect -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <TextBlock Grid.Column="0" Text="Dual-Write Operations" VerticalAlignment="Center"
                 FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Text0Brush}" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" FontSize="11.5" MaxWidth="380" TextWrapping="Wrap"
                   Foreground="{StaticResource Text2Brush}" />
        <Button Content="Stop waiting" Command="{Binding RunActionCancelCommand}" IsVisible="{Binding IsBusy}" />
        <Button Content="Connect" Command="{Binding LoadCommand}"
                Background="{StaticResource AccentBrush}" Foreground="{StaticResource OnAccentBrush}" />
      </StackPanel>
    </Grid>

    <!-- Live-environment banner (once connected) -->
    <Border Grid.Row="1" Margin="0,12,0,0" IsVisible="{Binding IsConnected}"
            Background="{StaticResource WarnBgBrush}"
            BorderBrush="{StaticResource WarnBrush}" BorderThickness="1" CornerRadius="8"
            Padding="12,8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="⚠" Foreground="{StaticResource WarnBrush}" VerticalAlignment="Center" />
        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
          <Run Text="Live environment. " FontWeight="SemiBold" Foreground="{StaticResource Text0Brush}" />
          <Run Text="{Binding ConnectionName}" Foreground="{StaticResource AccentBrush}" />
          <Run Text=" — every action is confirmed before it runs." Foreground="{StaticResource Text1Brush}" />
        </TextBlock>
      </StackPanel>
    </Border>

    <!-- Connect/load error -->
    <Border Grid.Row="2" Margin="0,12,0,0"
            IsVisible="{Binding LoadError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
            Background="{StaticResource ErrBgBrush}" BorderBrush="{StaticResource ErrBrush}"
            BorderThickness="1" CornerRadius="8" Padding="12,8">
      <TextBlock Text="{Binding LoadError}" TextWrapping="Wrap" Foreground="{StaticResource Text1Brush}" />
    </Border>

    <!-- Empty hint -->
    <TextBlock Grid.Row="3" Margin="2,16,0,0" IsVisible="{Binding !IsConnected}"
               Text="Connect to the dual-write gateway to list this environment's maps."
               Foreground="{StaticResource Text3Brush}" TextWrapping="Wrap" />

    <!-- Command bar (lifecycle actions) -->
    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0"
                IsVisible="{Binding IsConnected}">
      <Button Content="Start" Command="{Binding RunActionCommand}" CommandParameter="{Binding StartAction}" />
      <Button Content="Stop" Command="{Binding RunActionCommand}" CommandParameter="{Binding StopAction}" />
      <Button Content="Pause" Command="{Binding RunActionCommand}" CommandParameter="{Binding PauseAction}" />
      <Button Content="Resume" Command="{Binding RunActionCommand}" CommandParameter="{Binding ResumeAction}" />
      <Button Content="Initial sync" Command="{Binding RunActionCommand}" CommandParameter="{Binding InitialAction}" />
      <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource Text2Brush}"
                 Text="{Binding SelectedCount, StringFormat='{}{0} selected'}" />
      <Border Width="1" Background="{StaticResource StrokeBrush}" Margin="6,2,6,2" />
      <Button Content="Enable debug" Command="{Binding EnableDebugForSelectedCommand}"
              ToolTip.Tip="Turn on dual-write debug logging (IsDebugMode) for the selected map's F&amp;O project. Verbose failures are written to the DualWriteErrorLog table." />
      <Button Content="Disable debug" Command="{Binding DisableDebugForSelectedCommand}"
              ToolTip.Tip="Turn off dual-write debug logging for the selected map's F&amp;O project." />
      <TextBlock VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{StaticResource Text3Brush}"
                 TextTrimming="CharacterEllipsis" MaxWidth="360"
                 Text="{Binding DebugStatus}"
                 IsVisible="{Binding DebugStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>

    <!-- The captured write and later GET observation are independent, measured rows. -->
    <Border Grid.Row="4" x:Name="WriteReceiptPanel" IsVisible="{Binding HasWriteReceipt}" Margin="0,6,0,8"
            Padding="10" CornerRadius="6" Background="{StaticResource WarnBgBrush}" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1">
      <StackPanel Spacing="6">
        <TextBlock Text="Last write evidence — cancellation does not roll back a write" FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" />
        <ScrollViewer MaxHeight="90"><TextBlock x:Name="ReceiptText" Text="{Binding WriteReceiptText}" TextWrapping="Wrap" Foreground="{StaticResource Text1Brush}" /></ScrollViewer>
        <Button x:Name="ReconcileButton" Content="Read current state" Command="{Binding ReconcileCommand}" HorizontalAlignment="Left" />
        <TextBlock Text="{Binding ReconcileReason}" TextWrapping="Wrap" Foreground="{StaticResource Text2Brush}"
                   IsVisible="{Binding ReconcileReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <Border x:Name="ReadbackPanel" IsVisible="{Binding ReadbackText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Padding="8" Background="{StaticResource Layer1Brush}">
          <ScrollViewer MaxHeight="90"><TextBlock x:Name="ReadbackText" Text="{Binding ReadbackText}" TextWrapping="Wrap" Foreground="{StaticResource Text1Brush}" /></ScrollViewer>
        </Border>
      </StackPanel>
    </Border>
    <!-- Maps grid -->
    <DataGrid Grid.Row="5" x:Name="MapsGrid" Margin="0,12,0,0"
              IsVisible="{Binding HasMaps}"
              ItemsSource="{Binding Maps}" IsReadOnly="False"
              CanUserReorderColumns="False" CanUserResizeColumns="True"
              GridLinesVisibility="Horizontal" Background="{StaticResource Layer1Brush}">
      <DataGrid.Columns>
        <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected}" Width="40" />
        <DataGridTextColumn Header="Map" Binding="{Binding Name}" Width="2*" IsReadOnly="True" />
        <DataGridTextColumn Header="CE entity" Binding="{Binding CeEntity}" Width="*" IsReadOnly="True"
                            FontFamily="Cascadia Code,Consolas,monospace" />
        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="Auto" IsReadOnly="True" />
        <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="*" IsReadOnly="True" />
        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="*" IsReadOnly="True" />
      </DataGrid.Columns>
    </DataGrid>

    <!-- Gateway log: the discovered host, resolved cid, and each request's outcome — so a
         "no connection / cid" failure is diagnosable in-app without a network trace. -->
    <!-- The log is scoped per connect (cleared at the start of Load), so no manual clear is needed;
         collapse the Expander to declutter. -->
    <Expander Grid.Row="6" Margin="0,12,0,0" IsVisible="{Binding HasGatewayLog}" IsExpanded="True"
              Header="Gateway log">
      <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding GatewayLog}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:GatewayLogEntry">
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,1">
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                           FontFamily="Cascadia Code,Consolas,monospace" FontSize="11.5"
                           Foreground="{Binding Kind, Converter={x:Static conv:LogKindToBrushConverter.Instance}}" />
                <TextBlock Text="{Binding Note}" TextWrapping="Wrap"
                           FontFamily="Cascadia Code,Consolas,monospace" FontSize="11.5"
                           Foreground="{StaticResource Text3Brush}"
                           IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Expander>
  </Grid>
</UserControl>
