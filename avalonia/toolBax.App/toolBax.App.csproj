<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Public release exe is brand-named (avares:// authority in App.axaml + app.manifest identity follow). -->
    <AssemblyName>toolbAX</AssemblyName>
    <!-- Cross-platform target: Avalonia does not need the Windows Desktop runtime, and a
         platform-neutral core is a goal of the migration (#35). Windows-only concerns (DPAPI,
         WebView2) will live behind interfaces. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>ToolBax.App</RootNamespace>
    <!-- Windows Explorer / taskbar pinned-exe icon (the in-app window icon is Assets/icon.png). -->
    <ApplicationIcon>Assets/toolbax.ico</ApplicationIcon>
    <!-- The dual-write portal sign-in embeds WebView2 (via Avalonia's NativeControlHost), which is
         Windows-only. Enable it on Windows builds so the capture adapter compiles + links; Linux/CI
         builds the cross-platform flavour (fake sign-in) so the app stays net10.0 and the headless tests
         keep running. Override with -p:EnableWebView2=false to compile the cross-platform path on Windows. -->
    <EnableWebView2 Condition="'$(EnableWebView2)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">true</EnableWebView2>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableWebView2)' == 'true'">
    <DefineConstants>$(DefineConstants);WEBVIEW2</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableWebView2)' == 'true'">
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>

  <ItemGroup>
    <!-- App icon: icon.png is the runtime WindowIcon (avares:///Assets/icon.png). toolbax.ico is the
         exe icon, consumed only by <ApplicationIcon> at build time — exclude it from the embedded
         resource bundle so it isn't shipped twice. -->
    <AvaloniaResource Include="Assets/**" Exclude="Assets/*.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <!-- Embedded font so text measures/renders cross-platform (incl. headless Linux CI, where no
         system font is guaranteed). The Windows target still prefers Segoe via the design tokens. -->
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\toolBax.Core\toolBax.Core.csproj" />
    <!-- Real services for parity: consume the multi-targeted FoToolbox.Core (net10.0 flavor) so the
         Avalonia app reuses the WPF app's auth/OData/profiles/dual-write rather than reinventing. -->
    <ProjectReference Include="..\..\src\FoToolbox.Core\FoToolbox.Core.csproj" />
  </ItemGroup>

</Project>
