<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?ifndef ProductName?>
    <?define ProductName="FOtoolbox" ?>
  <?endif?>
  <?ifndef Manufacturer?>
    <?define Manufacturer="BenJones" ?>
  <?endif?>
  <?ifndef Version?>
    <?define Version="1.0.0" ?>
  <?endif?>
  <?ifndef InstallScope?>
    <?define InstallScope="perUserOrMachine" ?>
  <?endif?>
  <?ifndef ProductCode?>
    <?define ProductCode="{CE886CFF-6D3A-4ABE-BEA8-56444B3C6FB5}" ?>
  <?endif?>
  <?ifndef ProductCodeUser?>
    <?define ProductCodeUser="{CE886CFF-6D3A-4ABE-BEA8-56444B3C6FB5}" ?>
  <?endif?>
  <?ifndef ProductCodeMachine?>
    <?define ProductCodeMachine="{F9FE1558-8DCD-48F2-B208-12052B157604}" ?>
  <?endif?>
  <?ifndef UpgradeCode?>
    <?define UpgradeCode="{5E38A1ED-8CDD-4069-81F2-04C4DF076C11}" ?>
  <?endif?>
  <?ifndef AllowDowngrades?>
    <?define AllowDowngrades="no" ?>
  <?endif?>

  <?if $(var.InstallScope) = perMachine ?>
    <?undef ProductCode?>
    <?define ProductCode="$(var.ProductCodeMachine)" ?>
  <?else?>
    <?undef ProductCode?>
    <?define ProductCode="$(var.ProductCodeUser)" ?>
  <?endif?>

  <Package Name="$(var.ProductName)" Language="1033" Version="$(var.Version)" Manufacturer="$(var.Manufacturer)" UpgradeCode="$(var.UpgradeCode)" Scope="$(var.InstallScope)" ProductCode="$(var.ProductCode)">

    <?if $(var.AllowDowngrades) = yes ?>
      <MajorUpgrade AllowDowngrades="yes" />
    <?else?>
      <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of $(var.ProductName) is already installed." />
    <?endif?>

    <MediaTemplate EmbedCab="yes" />
    

    <Feature Id="MainFeature" Title="$(var.ProductName)" Level="1">
      <ComponentGroupRef Id="FoToolboxFiles" />
    </Feature>
  </Package>
</Wix>
