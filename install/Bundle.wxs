<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <?ifndef NetDesktopRuntimeVersion?>
    <?define NetDesktopRuntimeVersion="8.0.22" ?>
  <?endif?>
  <?ifndef NetDesktopRuntimeExe?>
    <?define NetDesktopRuntimeExe="redist\windowsdesktop-runtime-$(var.NetDesktopRuntimeVersion)-win-x64.exe" ?>
  <?endif?>
  <?ifndef NetDesktopRuntimeUrl?>
    <?define NetDesktopRuntimeUrl="https://aka.ms/dotnet/8.0/windowsdesktop-runtime-win-x64.exe" ?>
  <?endif?>
  <?ifndef FoToolboxMsiPath?>
    <?define FoToolboxMsiPath="FoToolbox.msi" ?>
  <?endif?>

  <Bundle Name="FO Toolbox Bundle" Version="0.1.0.0" Manufacturer="Contoso" UpgradeCode="{E2339E7F-00EC-49F0-ACCA-7A57F93AA363}">
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication Theme="hyperlinkLicense"
                                              LicenseUrl="https://example.com/fo-toolbox-license" />
    </BootstrapperApplication>

    <Variable Name="NetDesktopRuntime80Version" Type="version" Value="0.0.0" />
    <util:RegistrySearch Id="NetDesktopRuntime80"
                         Root="HKLM"
                         Key="SOFTWARE\dotnet\Setup\InstalledVersions\x64\sharedfx\Microsoft.WindowsDesktop.App"
                         Value="Version"
                         Variable="NetDesktopRuntime80Version" />

    <Chain>
      <PackageGroupRef Id="NetDesktopRuntime80" />
      <MsiPackage Id="FoToolboxMsi" SourceFile="$(var.FoToolboxMsiPath)" />
    </Chain>
  </Bundle>

  <Fragment>
    <PackageGroup Id="NetDesktopRuntime80">
      <ExePackage Id="NetDesktopRuntime80x64"
                  SourceFile="$(var.NetDesktopRuntimeExe)"
                  DownloadUrl="$(var.NetDesktopRuntimeUrl)"
                  Compressed="no"
                  PerMachine="yes"
                  Vital="yes"
                  DetectCondition="NetDesktopRuntime80Version AND NetDesktopRuntime80Version &gt;= v$(var.NetDesktopRuntimeVersion)"
                  InstallArguments="/install /quiet /norestart"
                  RepairArguments="/repair /quiet /norestart"
                  UninstallArguments="/uninstall /quiet /norestart" />
    </PackageGroup>
  </Fragment>
</Wix>
