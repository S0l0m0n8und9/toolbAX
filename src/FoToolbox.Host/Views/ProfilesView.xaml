<UserControl x:Class="FoToolbox.Host.Views.ProfilesView"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:FoToolbox.Core.Models;assembly=FoToolbox.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="900">
    <UserControl.Resources>
        <Style x:Key="VisibleWhenClientSecret" TargetType="{x:Type FrameworkElement}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Selected.Principal.AuthMode}" Value="{x:Static models:AuthMode.ClientSecret}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="VisibleWhenBearerToken" TargetType="{x:Type FrameworkElement}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Selected.Principal.AuthMode}" Value="{x:Static models:AuthMode.BearerToken}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="VisibleWhenCertificate" TargetType="{x:Type FrameworkElement}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Selected.Principal.AuthMode}" Value="{x:Static models:AuthMode.Certificate}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource Fo.SurfaceAltBrush}"
                BorderBrush="{DynamicResource Fo.BorderBrush}"
                BorderThickness="1"
                Padding="8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Add" Command="{Binding AddProfileCommand}" Margin="0,0,6,0" />
                    <Button Content="Delete" Command="{Binding DeleteProfileCommand}" />
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Profiles" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />
                    <ListBox ItemsSource="{Binding Profiles}"
                             SelectedItem="{Binding Selected, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Environment.Name}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="12">
            <StackPanel>
                <GroupBox Header="Environment" Margin="0,0,0,10">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding Selected.Environment.Name, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Base URL" VerticalAlignment="Center" Margin="0,6,0,0" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,0"
                                 Text="{Binding Selected.Environment.BaseUrl, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Tenant ID" VerticalAlignment="Center" Margin="0,6,0,0" />
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,6,0,0"
                                 Text="{Binding Selected.Environment.TenantId, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Default company" VerticalAlignment="Center" Margin="0,6,0,0" />
                        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,6,0,0"
                                 Text="{Binding Selected.Environment.DefaultCompany, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Authentication" Margin="0,0,0,10">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Client ID" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding Selected.Principal.ClientId, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Auth mode" VerticalAlignment="Center" Margin="0,6,0,0" />
                        <ComboBox x:Name="AuthModeComboBox" Grid.Row="1" Grid.Column="1" Margin="0,6,0,0"
                                  ItemsSource="{Binding AuthModeValues}"
                                  SelectedItem="{Binding Selected.Principal.AuthMode, Mode=TwoWay}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Client secret" VerticalAlignment="Center" Margin="0,6,0,0"
                                   Style="{StaticResource VisibleWhenClientSecret}" />
                        <PasswordBox x:Name="ClientSecretBox" Grid.Row="2" Grid.Column="1" Margin="0,6,0,0"
                                     Style="{StaticResource VisibleWhenClientSecret}" />

                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding StoredCredentialStatus}" Foreground="{DynamicResource Fo.SubtleTextBrush}" FontSize="10" Margin="0,4,0,0"
                                   Style="{StaticResource VisibleWhenClientSecret}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Bearer token" VerticalAlignment="Center" Margin="0,6,0,0"
                                   Style="{StaticResource VisibleWhenBearerToken}" />
                        <PasswordBox x:Name="BearerTokenBox" Grid.Row="4" Grid.Column="1" Margin="0,6,0,0"
                                     Style="{StaticResource VisibleWhenBearerToken}" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Retrieve token" VerticalAlignment="Center" Margin="0,6,0,0"
                                   Style="{StaticResource VisibleWhenBearerToken}" />
                        <Button Grid.Row="5" Grid.Column="1" Margin="0,6,0,0" Content="Get bearer token"
                                Command="{Binding AcquireBearerTokenCommand}"
                                Style="{StaticResource VisibleWhenBearerToken}" />

                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding StoredCredentialStatus}" Foreground="{DynamicResource Fo.SubtleTextBrush}" FontSize="10" Margin="0,4,0,0"
                                   Style="{StaticResource VisibleWhenBearerToken}" />

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="Cert thumbprint" VerticalAlignment="Center" Margin="0,6,0,0"
                                   Style="{StaticResource VisibleWhenCertificate}" />
                        <TextBox Grid.Row="7" Grid.Column="1" Margin="0,6,0,0"
                                 Text="{Binding Selected.Principal.CertThumbprint, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource VisibleWhenCertificate}" />
                    </Grid>
                </GroupBox>

                <WrapPanel Margin="0,0,0,10">
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,6,0" />
                    <Button Content="Save" Command="{Binding SaveCommand}" Margin="0,0,6,0" />
                    <Button Content="Set active" Command="{Binding SetActiveCommand}" Margin="0,0,6,0" />
                    <Button Content="Test connection" Command="{Binding TestConnectionCommand}" />
                </WrapPanel>

                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
