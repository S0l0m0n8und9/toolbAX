<Window x:Class="FoToolbox.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FO Toolbox" Height="540" Width="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Grid.Row="0" Background="#f3f4f6" Padding="8">
            <StackPanel>
                <TextBlock Text="Plugins" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />
                <ListBox ItemsSource="{Binding Plugins}"
                         SelectedItem="{Binding Selected, Mode=TwoWay}"
                         DisplayMemberPath="Name"
                         BorderThickness="0" />
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Grid.Row="0" Padding="12">
            <ContentControl Content="{Binding ActiveControl}" />
        </Border>

        <Border Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" Background="#eef2f7" Padding="8" BorderThickness="1" BorderBrush="#d5d7dc">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Channel:" Margin="0,0,4,0" />
                    <TextBlock Text="{Binding UpdateChannel}" FontWeight="Bold" Margin="0,0,12,0" />
                    <Button Content="Check updates" Command="{Binding CheckUpdatesCommand}" Margin="0,0,6,0" />
                    <Button Content="Apply staged update" Command="{Binding ApplyUpdateCommand}" Margin="0,0,6,0" />
                    <Button Content="Rollback" Command="{Binding RollbackUpdateCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding UpdateStatus}" Margin="0,4,0,0" />
                <TextBlock Text="{Binding StagedUpdatePath}" FontSize="10" Foreground="Gray" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
