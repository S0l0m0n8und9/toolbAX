<Window x:Class="FoToolbox.Host.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FO Toolbox" Height="500" Width="900">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#f3f4f6" Padding="8">
            <StackPanel>
                <TextBlock Text="Plugins" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />
                <ListBox ItemsSource="{Binding Plugins}"
                         SelectedItem="{Binding Selected, Mode=TwoWay}"
                         DisplayMemberPath="Name"
                         BorderThickness="0" />
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Padding="12">
            <ContentControl Content="{Binding ActiveControl}" />
        </Border>
    </Grid>
</Window>
