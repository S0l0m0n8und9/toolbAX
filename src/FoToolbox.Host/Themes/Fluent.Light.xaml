<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:sw="clr-namespace:System.Windows;assembly=PresentationFramework">
    <!--
      Warm-dark terminal palette — toolBax v2.0
      All colours derived from the design's oklch palette (amber accent).
      Single source of truth; views reference Brushes via DynamicResource only.
    -->

    <!-- Typography -->
    <FontFamily x:Key="Fo.FontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="Fo.FontFamily.Mono">Consolas, Courier New</FontFamily>
    <sys:Double x:Key="Fo.FontSize.Caption">10</sys:Double>
    <sys:Double x:Key="Fo.FontSize.Small">11</sys:Double>
    <sys:Double x:Key="Fo.FontSize.Body">12</sys:Double>
    <sys:Double x:Key="Fo.FontSize.SubHeading">14</sys:Double>
    <sys:Double x:Key="Fo.FontSize.Heading">15</sys:Double>

    <!-- ── Ink scale (dark backgrounds, oklch 0.12–0.46 warm) ───────────── -->
    <Color x:Key="Fo.Color.Ink0">#FF1E1913</Color>
    <Color x:Key="Fo.Color.Ink1">#FF28201A</Color>
    <Color x:Key="Fo.Color.Ink2">#FF32281E</Color>
    <Color x:Key="Fo.Color.Ink3">#FF403425</Color>
    <Color x:Key="Fo.Color.Ink4">#FF534536</Color>

    <!-- ── Paper scale (light text, oklch 0.94–0.58 warm) ──────────────── -->
    <Color x:Key="Fo.Color.Paper0">#FFF0E9D5</Color>
    <Color x:Key="Fo.Color.Paper1">#FFDAD0B8</Color>
    <Color x:Key="Fo.Color.Paper2">#FFB8AD96</Color>
    <Color x:Key="Fo.Color.Paper3">#FF968B77</Color>

    <!-- ── Accent — single amber ────────────────────────────────────────── -->
    <Color x:Key="Fo.Color.Accent">#FFD4A546</Color>
    <Color x:Key="Fo.Color.AccentDim">#FFB08030</Color>
    <Color x:Key="Fo.Color.AccentHover">#FFDCBC6A</Color>
    <Color x:Key="Fo.Color.AccentPressed">#FFB88C30</Color>

    <!-- ── Interaction surfaces (transparent) ───────────────────────────── -->
    <Color x:Key="Fo.Color.ControlHover">#0DF0E9D5</Color>
    <Color x:Key="Fo.Color.ControlPressed">#08F0E9D5</Color>
    <Color x:Key="Fo.Color.Selection">#24D4A546</Color>
    <Color x:Key="Fo.Color.SelectionHover">#33D4A546</Color>

    <!-- ── Hairlines (transparent borders) ──────────────────────────────── -->
    <Color x:Key="Fo.Color.Hair">#14F0E9D5</Color>
    <Color x:Key="Fo.Color.Hair2">#24F0E9D5</Color>

    <!-- ── Semantic states ───────────────────────────────────────────────── -->
    <Color x:Key="Fo.Color.Success">#FF6EC27E</Color>
    <Color x:Key="Fo.Color.Warning">#FFD49040</Color>
    <Color x:Key="Fo.Color.Error">#FFD45545</Color>
    <Color x:Key="Fo.Color.Info">#FF5BBAC8</Color>

    <!-- ── Legacy aliases for existing plugin views ─────────────────────── -->
    <Color x:Key="Fo.Color.WindowBackground">#FF1E1913</Color>
    <Color x:Key="Fo.Color.Surface">#FF28201A</Color>
    <Color x:Key="Fo.Color.SurfaceAlt">#FF32281E</Color>
    <Color x:Key="Fo.Color.SurfaceMuted">#FF403425</Color>
    <Color x:Key="Fo.Color.Border">#24F0E9D5</Color>
    <Color x:Key="Fo.Color.Text">#FFF0E9D5</Color>
    <Color x:Key="Fo.Color.SubtleText">#FFB8AD96</Color>

    <!-- ── Brushes ──────────────────────────────────────────────────────── -->
    <SolidColorBrush x:Key="Fo.Ink0Brush"           Color="{StaticResource Fo.Color.Ink0}" />
    <SolidColorBrush x:Key="Fo.Ink1Brush"           Color="{StaticResource Fo.Color.Ink1}" />
    <SolidColorBrush x:Key="Fo.Ink2Brush"           Color="{StaticResource Fo.Color.Ink2}" />
    <SolidColorBrush x:Key="Fo.Ink3Brush"           Color="{StaticResource Fo.Color.Ink3}" />
    <SolidColorBrush x:Key="Fo.Ink4Brush"           Color="{StaticResource Fo.Color.Ink4}" />
    <SolidColorBrush x:Key="Fo.Paper0Brush"         Color="{StaticResource Fo.Color.Paper0}" />
    <SolidColorBrush x:Key="Fo.Paper2Brush"         Color="{StaticResource Fo.Color.Paper2}" />
    <SolidColorBrush x:Key="Fo.Paper3Brush"         Color="{StaticResource Fo.Color.Paper3}" />
    <SolidColorBrush x:Key="Fo.HairBrush"           Color="{StaticResource Fo.Color.Hair}" />
    <SolidColorBrush x:Key="Fo.Hair2Brush"          Color="{StaticResource Fo.Color.Hair2}" />
    <SolidColorBrush x:Key="Fo.AccentBrush"         Color="{StaticResource Fo.Color.Accent}" />
    <SolidColorBrush x:Key="Fo.AccentDimBrush"      Color="{StaticResource Fo.Color.AccentDim}" />
    <SolidColorBrush x:Key="Fo.AccentHoverBrush"    Color="{StaticResource Fo.Color.AccentHover}" />
    <SolidColorBrush x:Key="Fo.AccentPressedBrush"  Color="{StaticResource Fo.Color.AccentPressed}" />
    <SolidColorBrush x:Key="Fo.ControlHoverBrush"   Color="{StaticResource Fo.Color.ControlHover}" />
    <SolidColorBrush x:Key="Fo.ControlPressedBrush" Color="{StaticResource Fo.Color.ControlPressed}" />
    <SolidColorBrush x:Key="Fo.SelectionBrush"      Color="{StaticResource Fo.Color.Selection}" />
    <SolidColorBrush x:Key="Fo.SelectionHoverBrush" Color="{StaticResource Fo.Color.SelectionHover}" />
    <SolidColorBrush x:Key="Fo.SuccessBrush"        Color="{StaticResource Fo.Color.Success}" />
    <SolidColorBrush x:Key="Fo.WarningBrush"        Color="{StaticResource Fo.Color.Warning}" />
    <SolidColorBrush x:Key="Fo.ErrorBrush"          Color="{StaticResource Fo.Color.Error}" />
    <SolidColorBrush x:Key="Fo.InfoBrush"           Color="{StaticResource Fo.Color.Info}" />

    <!-- Legacy brush aliases consumed by existing plugin views -->
    <SolidColorBrush x:Key="Fo.WindowBackgroundBrush" Color="{StaticResource Fo.Color.Ink0}" />
    <SolidColorBrush x:Key="Fo.SurfaceBrush"          Color="{StaticResource Fo.Color.Ink1}" />
    <SolidColorBrush x:Key="Fo.SurfaceAltBrush"       Color="{StaticResource Fo.Color.Ink2}" />
    <SolidColorBrush x:Key="Fo.SurfaceMutedBrush"     Color="{StaticResource Fo.Color.Ink3}" />
    <SolidColorBrush x:Key="Fo.BorderBrush"            Color="{StaticResource Fo.Color.Hair2}" />
    <SolidColorBrush x:Key="Fo.TextBrush"              Color="{StaticResource Fo.Color.Paper0}" />
    <SolidColorBrush x:Key="Fo.SubtleTextBrush"        Color="{StaticResource Fo.Color.Paper2}" />
    <SolidColorBrush x:Key="Fo.DimTextBrush"           Color="{StaticResource Fo.Color.Paper3}" />

    <!-- WPF system brush overrides for dark theme readability -->
    <SolidColorBrush x:Key="{x:Static sw:SystemColors.WindowBrushKey}"        Color="{StaticResource Fo.Color.Ink1}" />
    <SolidColorBrush x:Key="{x:Static sw:SystemColors.ControlBrushKey}"       Color="{StaticResource Fo.Color.Ink2}" />
    <SolidColorBrush x:Key="{x:Static sw:SystemColors.ControlLightBrushKey}"  Color="{StaticResource Fo.Color.Ink3}" />
    <SolidColorBrush x:Key="{x:Static sw:SystemColors.ControlDarkBrushKey}"   Color="{StaticResource Fo.Color.Hair2}" />
    <SolidColorBrush x:Key="{x:Static sw:SystemColors.ControlTextBrushKey}"   Color="{StaticResource Fo.Color.Paper0}" />
    <SolidColorBrush x:Key="{x:Static sw:SystemColors.WindowTextBrushKey}"    Color="{StaticResource Fo.Color.Paper0}" />
    <SolidColorBrush x:Key="{x:Static sw:SystemColors.GrayTextBrushKey}"      Color="{StaticResource Fo.Color.Paper2}" />
    <SolidColorBrush x:Key="{x:Static sw:SystemColors.HighlightBrushKey}"     Color="{StaticResource Fo.Color.Selection}" />
    <SolidColorBrush x:Key="{x:Static sw:SystemColors.HighlightTextBrushKey}" Color="{StaticResource Fo.Color.Paper0}" />

    <!-- Layout tokens — sharp 2px radius matches terminal aesthetic -->
    <CornerRadius x:Key="Fo.CornerRadius.Card">2</CornerRadius>
    <CornerRadius x:Key="Fo.CornerRadius.Control">2</CornerRadius>
    <Thickness x:Key="Fo.BorderThickness.Control">1</Thickness>
    <Thickness x:Key="Fo.Padding.Control">10,5</Thickness>
</ResourceDictionary>
