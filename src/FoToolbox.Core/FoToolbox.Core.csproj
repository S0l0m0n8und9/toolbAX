<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-target so the cross-platform Avalonia app can consume the same real services as the
         WPF host. WPF + tests consume net10.0-windows (unchanged); Avalonia consumes net10.0.
         DPAPI/Windows-only types are [SupportedOSPlatform("windows")]-annotated for CA1416. -->
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildProjectDirectory)\..\..\build\fotoolbox.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Identity.Client" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\\table-catalog-10.0.40.json" />
  </ItemGroup>

</Project>
