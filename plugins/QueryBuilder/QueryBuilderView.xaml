<UserControl x:Class="QueryBuilderPlugin.QueryBuilderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:QueryBuilderPlugin"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1100">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBooleanConverter x:Key="NotBool" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Responsive: left grows with window, and user can drag the splitter. -->
            <ColumnDefinition Width="1.25*" MinWidth="330" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="2*" MinWidth="520" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Column="0" Grid.Row="0" Margin="8"
                Background="{DynamicResource Fo.SurfaceAltBrush}"
                BorderBrush="{DynamicResource Fo.BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="Entity Explorer" FontWeight="Bold" DockPanel.Dock="Left" />
                        <WrapPanel DockPanel.Dock="Right">
                            <Button Content="Load Entities"
                                    Command="{Binding LoadEntitiesCommand}"
                                    IsEnabled="{Binding IsLoadingEntities, Converter={StaticResource NotBool}}"
                                    MinWidth="96"
                                    Padding="10,4"
                                    Margin="0,0,6,0" />
                            <Button Content="Refresh"
                                    Command="{Binding RefreshEntitiesCommand}"
                                    IsEnabled="{Binding IsLoadingEntities, Converter={StaticResource NotBool}}"
                                    MinWidth="72"
                                    Padding="10,4" />
                        </WrapPanel>
                    </DockPanel>
                    <TextBlock Text="Search" FontSize="11" Foreground="{DynamicResource Fo.SubtleTextBrush}" Margin="0,10,0,2" />
                    <TextBox Text="{Binding EntitySearch, UpdateSourceTrigger=PropertyChanged}" />
                    <ProgressBar Height="6" Margin="0,6,0,0" IsIndeterminate="True" Visibility="{Binding IsLoadingEntities, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding EntityLoadStatus}" FontSize="11" Foreground="{DynamicResource Fo.SubtleTextBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- DataGrid columns can star-size; GridViewColumn cannot, which caused the "never wide enough" feel. -->
                <DataGrid ItemsSource="{Binding EntitiesView}"
                          SelectedValuePath="Name"
                          SelectedValue="{Binding SelectedEntity, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeColumns="True"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          BorderThickness="0"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=OneWay}" Width="240" MinWidth="180" />
                        <DataGridTextColumn Header="Fields" Binding="{Binding PropertyCount, Mode=OneWay}" Width="90" MinWidth="80" />
                        <DataGridTextColumn Header="Nav" Binding="{Binding NavigationCount, Mode=OneWay}" Width="90" MinWidth="80" />
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <TextBlock Text="{Binding EntityListSummary}" FontSize="11" Foreground="{DynamicResource Fo.SubtleTextBrush}" />
                    <TextBlock Text="{Binding SelectedEntitySummary}" FontSize="11" Foreground="{DynamicResource Fo.SubtleTextBrush}" Margin="0,2,0,0" />
                    <Button Content="Refresh Selected Entity"
                            Command="{Binding RefreshSelectedEntityCommand}"
                            IsEnabled="{Binding IsLoadingEntities, Converter={StaticResource NotBool}}"
                            Padding="10,4"
                            Margin="0,6,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1"
                      Grid.Row="0"
                      Grid.RowSpan="3"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="{DynamicResource Fo.BorderBrush}"
                      ShowsPreview="True" />

        <Border Grid.Column="2" Grid.Row="0" Margin="8"
                Background="{DynamicResource Fo.SurfaceBrush}"
                BorderBrush="{DynamicResource Fo.BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Query Preview" FontWeight="SemiBold" FontSize="14" />
                    <TextBox Text="{Binding QueryPreview}"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Height="80"
                             FontFamily="Consolas"
                             Background="{DynamicResource Fo.SurfaceAltBrush}"
                             BorderBrush="{DynamicResource Fo.BorderBrush}"
                             Margin="0,6,0,0" />
                </StackPanel>

                <TabControl Grid.Row="1">
                <TabItem Header="Fields">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="True">
                            <StackPanel Width="220" DockPanel.Dock="Left" Margin="0,0,12,0">
                                <TextBlock Text="Search fields" FontSize="10" Foreground="{DynamicResource Fo.SubtleTextBrush}" />
                                <TextBox Text="{Binding FieldSearch, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <WrapPanel VerticalAlignment="Bottom">
                                <CheckBox Content="Properties" IsChecked="{Binding ShowProperties}" Margin="0,0,12,2" />
                                <CheckBox Content="Navigation" IsChecked="{Binding ShowNavigation}" Margin="0,0,12,2" />
                                <Button Content="Select All" Command="{Binding SelectAllFieldsCommand}" Margin="0,0,6,2" />
                                <Button Content="Select Visible" Command="{Binding SelectVisibleFieldsCommand}" Margin="0,0,6,2" />
                                <Button Content="Clear" Command="{Binding ClearFieldSelectionCommand}" Margin="0,0,0,2" />
                            </WrapPanel>
                        </DockPanel>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding FieldsView}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserResizeColumns="True"
                                  HeadersVisibility="Column"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Sel" Binding="{Binding IsSelected, Mode=TwoWay}" Width="60" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=OneWay}" IsReadOnly="True" Width="240" MinWidth="180" />
                                <DataGridTextColumn Header="Kind" Binding="{Binding Kind, Mode=OneWay}" IsReadOnly="True" Width="110" MinWidth="90" />
                                <DataGridCheckBoxColumn Header="Key" Binding="{Binding IsKey, Mode=OneWay}" IsReadOnly="True" Width="70" />
                                <DataGridCheckBoxColumn Header="Mandatory" Binding="{Binding Mandatory, Mode=OneWay}" IsReadOnly="True" Width="110" />
                                <DataGridTextColumn Header="Type" Binding="{Binding Type, Mode=OneWay}" IsReadOnly="True" Width="200" MinWidth="160" />
                                <DataGridTextColumn Header="Max Len" Binding="{Binding MaxLength, Mode=OneWay}" IsReadOnly="True" Width="100" />
                                <DataGridTextColumn Header="Prec/Scale" Binding="{Binding PrecisionScale, Mode=OneWay}" IsReadOnly="True" Width="130" />
                                <DataGridTextColumn Header="Range" Binding="{Binding Range, Mode=OneWay}" IsReadOnly="True" Width="160" />
                                <DataGridTextColumn Header="Enum Values" Binding="{Binding EnumValues, Mode=OneWay}" IsReadOnly="True" Width="280" MinWidth="200" />
                                <DataGridCheckBoxColumn Header="Nullable" Binding="{Binding Nullable, Mode=OneWay}" IsReadOnly="True" Width="95" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{Binding FieldListSummary}" FontSize="10" Foreground="{DynamicResource Fo.SubtleTextBrush}" />
                            <TextBlock Text=" | " FontSize="10" Foreground="{DynamicResource Fo.SubtleTextBrush}" Margin="4,0" />
                            <TextBlock Text="{Binding FieldSelectionSummary}" FontSize="10" Foreground="{DynamicResource Fo.SubtleTextBrush}" />
                        </StackPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="Filter">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8">
                            <TextBlock Text="Filter Builder" FontWeight="Bold" />
                            <TextBlock Text="{Binding FilterHint}" FontSize="10" Foreground="{DynamicResource Fo.SubtleTextBrush}" Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Button Content="+ Condition" Command="{Binding AddConditionCommand}" Margin="0,0,4,0" />
                                <Button Content="+ Group" Command="{Binding AddGroupCommand}" />
                            </StackPanel>
                            <TreeView ItemsSource="{Binding RootGroup.Children}"
                                      BorderThickness="1"
                                      Height="200"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <TreeView.Resources>
                                    <HierarchicalDataTemplate DataType="{x:Type local:FilterGroupViewModel}" ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                            <ComboBox Width="60" SelectedValue="{Binding LogicalOperator, Mode=TwoWay}">
                                                <ComboBoxItem Content="and" />
                                                <ComboBoxItem Content="or" />
                                            </ComboBox>
                                            <Button Content="+ Cond" Margin="4,0,0,0" Command="{Binding DataContext.AddConditionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            <Button Content="+ Group" Margin="4,0,0,0" Command="{Binding DataContext.AddGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                            <Button Content="X" Margin="4,0,0,0" Command="{Binding DataContext.RemoveNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                    <DataTemplate DataType="{x:Type local:FilterConditionViewModel}">
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                            <ComboBox Width="200"
                                                      ItemsSource="{Binding DataContext.FilterFields, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      DisplayMemberPath="Name"
                                                      SelectedValuePath="Name"
                                                      SelectedValue="{Binding Field, Mode=TwoWay}" />
                                            <ComboBox Width="80" Margin="4,0,0,0" SelectedValue="{Binding Operator, Mode=TwoWay}" SelectedValuePath="Content">
                                                <ComboBoxItem Content="eq" />
                                                <ComboBoxItem Content="ne" />
                                                <ComboBoxItem Content="gt" />
                                                <ComboBoxItem Content="ge" />
                                                <ComboBoxItem Content="lt" />
                                                <ComboBoxItem Content="le" />
                                                <ComboBoxItem Content="startswith" />
                                                <ComboBoxItem Content="endswith" />
                                                <ComboBoxItem Content="contains" />
                                            </ComboBox>
                                            <Grid Margin="4,0,0,0">
                                                <ComboBox Width="200"
                                                          ItemsSource="{Binding EnumValues}"
                                                          IsEditable="True"
                                                          IsTextSearchEnabled="True"
                                                          Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Visibility="{Binding HasEnumValues, Converter={StaticResource BoolToVis}}" />
                                                <TextBox Width="200" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasEnumValues}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                            </Grid>
                                            <Button Content="X" Margin="4,0,0,0" Command="{Binding DataContext.RemoveNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </TreeView.Resources>
                            </TreeView>
                            <TextBlock Text="{Binding ValidationWarning}" Foreground="OrangeRed" Margin="0,4,0,0" />

                            <TextBlock Text="Builder Preview" FontWeight="Bold" Margin="0,12,0,0" />
                            <TextBox Text="{Binding FilterBuilderPreview}" IsReadOnly="True" TextWrapping="Wrap" Height="60" VerticalScrollBarVisibility="Auto" />

                            <TextBlock Text="Raw $filter" FontWeight="Bold" Margin="0,12,0,0" />
                            <TextBox Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

                            <TextBlock Text="{Binding FilterUsageHint}" FontSize="10" Foreground="{DynamicResource Fo.SubtleTextBrush}" Margin="0,4,0,0" />

                            <TextBlock Text="Effective Filter" FontWeight="Bold" Margin="0,12,0,0" />
                            <TextBox Text="{Binding EffectiveFilterPreview}" IsReadOnly="True" TextWrapping="Wrap" Height="60" VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Options">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8">
                            <TextBlock Text="Query Options" FontWeight="Bold" />
                            <CheckBox Content="Cross-company (on by default)" IsChecked="{Binding CrossCompany}" Margin="0,6,0,0" />
                            <TextBlock Text="Company (optional)" />
                            <TextBox Text="{Binding Company, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox Content="$count" IsChecked="{Binding Count}" Margin="0,6,0,0" />

                            <TextBlock Text="Paging" FontWeight="Bold" Margin="0,12,0,0" />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="$top" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Text="{Binding Top, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" MinWidth="60" />
                                <TextBlock Text="$skip" Grid.Column="2" VerticalAlignment="Center" Margin="12,0,6,0" />
                                <TextBox Text="{Binding Skip, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Column="3" MinWidth="60" />
                            </Grid>
                            <TextBlock Text="Leave empty to use server-driven paging." FontSize="10" Foreground="{DynamicResource Fo.SubtleTextBrush}" Margin="0,4,0,0" />

                            <TextBlock Text="Order by" FontWeight="Bold" Margin="0,12,0,0" />
                            <TextBox Text="{Binding OrderBy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="$expand (1 level)" FontWeight="Bold" Margin="0,12,0,0" />
                            <TextBlock Text="Choose a navigation property to bring related records. Only one level is supported." FontSize="10" Foreground="{DynamicResource Fo.SubtleTextBrush}" Margin="0,0,0,4" />
                            <ComboBox IsEditable="True"
                                      ItemsSource="{Binding NavigationHints}"
                                      Text="{Binding ExpandPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      StaysOpenOnEdit="True"
                                      IsTextSearchEnabled="True" />
                            <TextBlock Text="{Binding ExpandSummary}" FontSize="10" Foreground="{DynamicResource Fo.SubtleTextBrush}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding ExpandWarning}" Foreground="OrangeRed" />
                            <TextBlock Text="Navigation hints" FontWeight="Bold" Margin="0,12,0,0" />
                            <ItemsControl ItemsSource="{Binding NavigationHints}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="10" Foreground="{DynamicResource Fo.SubtleTextBrush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Response">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8">
                            <TextBlock Text="Last Response" FontWeight="Bold" />
                            <TextBlock Text="Run Preview to populate response metadata and headers." FontSize="10" Foreground="{DynamicResource Fo.SubtleTextBrush}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding ResponseDetails}"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     Height="300"
                                     FontFamily="Consolas"
                                     Background="{DynamicResource Fo.SurfaceAltBrush}"
                                     BorderBrush="{DynamicResource Fo.BorderBrush}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Saved">
                    <StackPanel Margin="8">
                        <TextBlock Text="Saved queries" FontWeight="Bold" />
                        <ListBox ItemsSource="{Binding SavedQueries}"
                                 SelectedItem="{Binding SelectedSaved, Mode=TwoWay}"
                                 DisplayMemberPath="Name"
                                 Height="200" />
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="Save" Command="{Binding SaveQueryCommand}" Margin="0,0,4,0" />
                            <Button Content="Load" Command="{Binding LoadSavedQueryCommand}" Margin="0,0,4,0" />
                            <Button Content="Delete" Command="{Binding DeleteSavedQueryCommand}" Margin="0,0,4,0" />
                            <Button Content="Rename" Command="{Binding RenameSavedQueryCommand}" />
                        </WrapPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="Export OpenCollection" Command="{Binding ExportSavedOpenCollectionCommand}" Margin="0,0,4,0" />
                            <Button Content="Export All (OpenCollection)" Command="{Binding ExportAllSavedOpenCollectionCommand}" Margin="0,0,4,0" />
                            <Button Content="Import OpenCollection" Command="{Binding ImportOpenCollectionCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </TabItem>
                </TabControl>
            </Grid>
        </Border>

        <Border Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" Margin="8"
                Background="{DynamicResource Fo.SurfaceBrush}"
                BorderBrush="{DynamicResource Fo.BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10">
            <DataGrid ItemsSource="{Binding PreviewTable}"
                      AutoGenerateColumns="True"
                      CanUserAddRows="False"
                      CanUserResizeColumns="True"
                      IsReadOnly="True"
                      HeadersVisibility="All"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      GridLinesVisibility="Horizontal" />
        </Border>

        <Border Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="2" Margin="8"
                Background="{DynamicResource Fo.SurfaceAltBrush}"
                BorderBrush="{DynamicResource Fo.BorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="8">
            <DockPanel>
                <TextBlock Text="{Binding Status}" DockPanel.Dock="Left" TextWrapping="Wrap" VerticalAlignment="Center" />
                <WrapPanel HorizontalAlignment="Right">
                    <Button Content="Preview" Command="{Binding PreviewCommand}" Margin="4,0,0,0" Padding="10,4" />
                    <Button Content="Load more" Command="{Binding LoadMoreCommand}" Margin="4,0,0,0" Padding="10,4" IsEnabled="{Binding HasMoreNextLink}" />
                    <Button Content="Export Page" Command="{Binding ExportPageCommand}" Margin="4,0,0,0" Padding="10,4" />
                    <Button Content="Export All" Command="{Binding ExportAllCommand}" Margin="4,0,0,0" Padding="10,4" />
                </WrapPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
