<Window x:Class="DualWriteComparePlugin.DualWriteSignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Sign in to Dual-write"
        Height="760" Width="620"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Margin="10,8" TextWrapping="Wrap"
                   Text="Sign in with your Dynamics 365 account. This window captures a dual-write access token and discovers the gateway automatically — it closes itself when done." />
        <wv2:WebView2 Grid.Row="1" x:Name="Web" />
    </Grid>
</Window>
