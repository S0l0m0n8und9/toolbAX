<UserControl x:Class="DualWriteComparePlugin.DualWriteCompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:DualWriteComparePlugin"
             mc:Ignorable="d"
             d:DesignHeight="640"
             d:DesignWidth="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Two connection editors -->
        <Grid Grid.Row="0" Margin="8,8,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ContentControl Grid.Column="0" Content="{Binding Left}" Margin="0,0,4,0">
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <Border Padding="10" Margin="0"
                                Background="{DynamicResource Fo.SurfaceAltBrush}"
                                BorderBrush="{DynamicResource Fo.BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Fo.CornerRadius.Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock Text="Gateway base URL" Margin="0,0,0,2" />
                                <TextBox Text="{Binding GatewayBaseUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
                                <TextBlock Text="F&amp;O identifier" Margin="0,0,0,2" />
                                <TextBox Text="{Binding FoIdentifier, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
                                <WrapPanel Margin="0,2,0,0">
                                    <Button Content="Sign in…" Command="{Binding SignInCommand}" Padding="10,3" MinWidth="80"
                                            ToolTip="Interactive sign-in: captures the token and discovers the gateway for this environment (no manual paste)." />
                                    <Button Content="Switch account…" Command="{Binding SwitchAccountCommand}" Padding="10,3" MinWidth="110" Margin="6,0,0,0"
                                            ToolTip="Forget the cached browser session and sign in as a different account." />
                                    <Button Content="Clear Token" Command="{Binding ClearTokenCommand}" Padding="10,3" MinWidth="90" Margin="6,0,0,0"
                                            ToolTip="Remove the stored token/session for this environment (keeps the gateway URL and identifier)." />
                                </WrapPanel>
                                <TextBlock Text="{Binding Summary}" Opacity="0.8" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
            <ContentControl Grid.Column="1" Content="{Binding Right}" Margin="4,0,0,0">
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <Border Padding="10" Margin="0"
                                Background="{DynamicResource Fo.SurfaceAltBrush}"
                                BorderBrush="{DynamicResource Fo.BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Fo.CornerRadius.Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock Text="Gateway base URL" Margin="0,0,0,2" />
                                <TextBox Text="{Binding GatewayBaseUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
                                <TextBlock Text="F&amp;O identifier" Margin="0,0,0,2" />
                                <TextBox Text="{Binding FoIdentifier, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" />
                                <WrapPanel Margin="0,2,0,0">
                                    <Button Content="Sign in…" Command="{Binding SignInCommand}" Padding="10,3" MinWidth="80"
                                            ToolTip="Interactive sign-in: captures the token and discovers the gateway for this environment (no manual paste)." />
                                    <Button Content="Switch account…" Command="{Binding SwitchAccountCommand}" Padding="10,3" MinWidth="110" Margin="6,0,0,0"
                                            ToolTip="Forget the cached browser session and sign in as a different account." />
                                    <Button Content="Clear Token" Command="{Binding ClearTokenCommand}" Padding="10,3" MinWidth="90" Margin="6,0,0,0"
                                            ToolTip="Remove the stored token/session for this environment (keeps the gateway URL and identifier)." />
                                </WrapPanel>
                                <TextBlock Text="{Binding Summary}" Opacity="0.8" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Grid>

        <!-- Action bar -->
        <DockPanel Grid.Row="1" Margin="8">
            <Button DockPanel.Dock="Left" Content="Save A" Command="{Binding SaveLeftCommand}" Padding="10,4" MinWidth="80" />
            <Button DockPanel.Dock="Left" Content="Save B" Command="{Binding SaveRightCommand}" Padding="10,4" MinWidth="80" Margin="6,0,0,0" />
            <Button DockPanel.Dock="Left" Content="Compare" Command="{Binding CompareCommand}" Padding="14,4" MinWidth="100" Margin="12,0,0,0" IsEnabled="{Binding IsNotBusy}" />
            <CheckBox DockPanel.Dock="Left" Content="Show only differences" VerticalAlignment="Center" Margin="12,0,0,0"
                      IsChecked="{Binding ShowOnlyDifferences}" />
            <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" Text="{Binding SummaryMessage}" />
        </DockPanel>

        <!-- Results -->
        <DataGrid Grid.Row="2" Margin="8,0,8,0"
                  ItemsSource="{Binding RowsView}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Map" Binding="{Binding MapName}" Width="2*" />
                <DataGridTextColumn Header="Verdict" Binding="{Binding Verdict}" Width="*" />
                <DataGridTextColumn Header="Version A" Binding="{Binding LeftVersion}" Width="*" />
                <DataGridTextColumn Header="Version B" Binding="{Binding RightVersion}" Width="*" />
                <DataGridTextColumn Header="State A" Binding="{Binding LeftState}" Width="*" />
                <DataGridTextColumn Header="State B" Binding="{Binding RightState}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Margin="8" Padding="10"
                Background="{DynamicResource Fo.SurfaceAltBrush}"
                BorderBrush="{DynamicResource Fo.BorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Fo.CornerRadius.Card}">
            <TextBlock TextWrapping="Wrap" Text="{Binding StatusMessage}" />
        </Border>
    </Grid>
</UserControl>
