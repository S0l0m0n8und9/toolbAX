<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <RepoRoot Condition="'$(RepoRoot)' == '' and '$(SolutionDir)' != ''">$(SolutionDir)</RepoRoot>
    <RepoRoot Condition="'$(RepoRoot)' == ''">$(MSBuildProjectDirectory)\..\..\</RepoRoot>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildProjectDirectory)\..\..\build\fotoolbox.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\\..\\src\\FoToolbox.SDK\\FoToolbox.SDK.csproj" />
    <ProjectReference Include="..\\..\\src\\FoToolbox.Core\\FoToolbox.Core.csproj" />
    <ProjectReference Include="..\..\src\FoToolbox.SDK.Wpf\FoToolbox.SDK.Wpf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="PluginManifest.json" />
  </ItemGroup>

  <!-- Copy into a per-plugin subfolder (canonical layout), matching the other plugins. Copying flat
       into plugins\ root dumps the dependency closure (FoToolbox.Core/SDK, Microsoft.*, SQLitePCLRaw.*)
       loose in the root, where the host discovers them as unsigned LegacyFlat plugin candidates and
       pops a blocking "unsigned plugin wants to load" trust prompt that wedges startup once a profile
       is active. -->
  <Target Name="CopyPluginToHostBin" AfterTargets="Build">
    <ItemGroup>
      <PluginOutput Include="$(TargetDir)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginOutput)" DestinationFiles="@(PluginOutput->'$(RepoRoot)src\\FoToolbox.Host\\bin\\$(Configuration)\\$(TargetFramework)\\plugins\\HelloPlugin\\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
