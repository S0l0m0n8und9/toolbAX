<UserControl x:Class="TableEntityBrowserPlugin.TableEntityBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:TableEntityBrowserPlugin"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1100">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:InverseBooleanConverter x:Key="NotBool" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <WrapPanel>
                <Button Content="Load Tables" Command="{Binding LoadTablesCommand}"
                        MinWidth="96" Padding="10,4"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource NotBool}}" />
                <Button Content="Load Entities" Command="{Binding LoadEntitiesCommand}"
                        MinWidth="96" Padding="10,4" Margin="6,0,0,0"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource NotBool}}" />
                <Button Content="Refresh Entities" Command="{Binding RefreshEntitiesCommand}"
                        MinWidth="110" Padding="10,4" Margin="6,0,0,0"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource NotBool}}" />
                <Button Content="Refresh All" Command="{Binding RefreshAllCommand}"
                        MinWidth="96" Padding="10,4" Margin="6,0,0,0"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource NotBool}}" />
                <Button Content="Import Tables" Command="{Binding ImportTablesCommand}"
                        MinWidth="96" Padding="10,4" Margin="6,0,0,0"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource NotBool}}" />
                <Button Content="Save Import Template" Command="{Binding SaveImportTemplateCommand}"
                        MinWidth="140" Padding="10,4" Margin="6,0,0,0"
                        ToolTip="Creates a starter JSON file for the Import Tables feature."
                        IsEnabled="{Binding IsBusy, Converter={StaticResource NotBool}}" />
            </WrapPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Working..." Foreground="{DynamicResource Fo.SubtleTextBrush}" Margin="0,0,8,0"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <ProgressBar Width="140" Height="10" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <!-- Responsive: left grows with window, and user can drag the splitter. -->
                <ColumnDefinition Width="1.2*" MinWidth="340" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="2*" MinWidth="520" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource Fo.SurfaceAltBrush}"
                    BorderBrush="{DynamicResource Fo.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Fo.CornerRadius.Card}"
                    Padding="10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Tables" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="Search" FontSize="11" Foreground="{DynamicResource Fo.SubtleTextBrush}" Margin="0,10,0,2" />
                        <TextBox Text="{Binding TableSearch, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding TablesView}"
                              SelectedItem="{Binding SelectedTable, Mode=TwoWay}"
                              Margin="0,10,0,0"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeColumns="True"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              BorderThickness="0"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=OneWay}" Width="240" MinWidth="180" />
                            <DataGridTextColumn Header="Label" Binding="{Binding Label, Mode=OneWay}" Width="360" MinWidth="260" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <TextBlock Text="{Binding TableListSummary}" FontSize="11" Foreground="{DynamicResource Fo.SubtleTextBrush}" />
                        <TextBlock Text="{Binding SelectedTableSummary}" FontSize="11" Foreground="{DynamicResource Fo.SubtleTextBrush}" Margin="0,2,0,0" />

                        <TextBox Text="{Binding SelectedTableBrowserUrl}"
                                 IsReadOnly="True"
                                 FontSize="11"
                                 Margin="0,8,0,0"
                                 TextWrapping="NoWrap"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Hidden"
                                 ToolTip="{Binding SelectedTableBrowserUrl}" />

                        <Button Content="Open Table Browser"
                                Command="{Binding OpenTableBrowserCommand}"
                                Margin="0,6,0,0"
                                Padding="10,4" />

                        <Separator Margin="0,12,0,12" />

                        <TextBlock Text="Table Browser URL Template" FontSize="11" Foreground="{DynamicResource Fo.SubtleTextBrush}" Margin="0,0,0,2" />
                        <TextBox Text="{Binding TableBrowserTemplate, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="11"
                                 FontFamily="Consolas"
                                 ToolTip="Use {BaseUrl} and {TableName}" />
                        <TextBlock Text="Use {BaseUrl} and {TableName}" FontSize="10" Foreground="{DynamicResource Fo.SubtleTextBrush}" Margin="0,4,0,0" />
                        <Button Content="Save Template"
                                Command="{Binding SaveTemplateCommand}"
                                Margin="0,6,0,0"
                                Padding="10,4" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource Fo.BorderBrush}"
                          ShowsPreview="True" />

            <Border Grid.Column="2"
                    Background="{DynamicResource Fo.SurfaceBrush}"
                    BorderBrush="{DynamicResource Fo.BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Fo.CornerRadius.Card}"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Entities" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="Search" FontSize="11" Foreground="{DynamicResource Fo.SubtleTextBrush}" Margin="0,10,0,2" />
                        <TextBox Text="{Binding EntitySearch, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding EntitiesView}"
                              SelectedItem="{Binding SelectedEntity, Mode=TwoWay}"
                              Margin="0,10,0,0"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserResizeColumns="True"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              BorderThickness="0"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=OneWay}" Width="260" MinWidth="180" />
                            <DataGridTextColumn Header="Fields" Binding="{Binding PropertyCount, Mode=OneWay}" Width="100" MinWidth="90" />
                            <DataGridTextColumn Header="Nav" Binding="{Binding NavigationCount, Mode=OneWay}" Width="90" MinWidth="80" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock Text="{Binding EntityListSummary}" FontSize="11" Foreground="{DynamicResource Fo.SubtleTextBrush}" />
                        <TextBlock Text="{Binding SelectedEntitySummary}" FontSize="11" Foreground="{DynamicResource Fo.SubtleTextBrush}" Margin="0,2,0,0" />
                        <TextBox Text="{Binding SelectedEntityEndpoint}"
                                 IsReadOnly="True"
                                 FontSize="11"
                                 Margin="0,8,0,0"
                                 TextWrapping="NoWrap"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Hidden"
                                 ToolTip="{Binding SelectedEntityEndpoint}" />
                        <Button Content="Refresh Selected Entity"
                                Command="{Binding RefreshSelectedEntityCommand}"
                                Margin="0,6,0,0"
                                Padding="10,4"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource NotBool}}" />
                    </StackPanel>

                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DataGrid Grid.Row="0"
                                  ItemsSource="{Binding EntityFields}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserResizeColumns="True"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <!-- Explicit OneWay bindings avoid WPF defaulting to TwoWay and crashing on get-only properties. -->
                                <DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=OneWay}" IsReadOnly="True" Width="240" MinWidth="180" />
                                <DataGridTextColumn Header="Type" Binding="{Binding Type, Mode=OneWay}" IsReadOnly="True" Width="220" MinWidth="160" />
                                <DataGridTextColumn Header="Max Len" Binding="{Binding MaxLength, Mode=OneWay}" IsReadOnly="True" Width="100" />
                                <DataGridTextColumn Header="Prec/Scale" Binding="{Binding PrecisionScale, Mode=OneWay}" IsReadOnly="True" Width="130" />
                                <DataGridTextColumn Header="Range" Binding="{Binding Range, Mode=OneWay}" IsReadOnly="True" Width="180" />
                                <DataGridCheckBoxColumn Header="Key" Binding="{Binding IsKey, Mode=OneWay}" IsReadOnly="True" Width="70" />
                                <DataGridCheckBoxColumn Header="Mandatory" Binding="{Binding Mandatory, Mode=OneWay}" IsReadOnly="True" Width="110" />
                                <DataGridCheckBoxColumn Header="Nullable" Binding="{Binding Nullable, Mode=OneWay}" IsReadOnly="True" Width="100" />
                                <DataGridTextColumn Header="Enum Values" Binding="{Binding EnumValues, Mode=OneWay}" IsReadOnly="True" Width="320" MinWidth="220" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding NavigationHints}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource Fo.SubtleTextBrush}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource Fo.BorderBrush}"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource Fo.SurfaceAltBrush}"
                Padding="8">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
