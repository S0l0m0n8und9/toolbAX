<UserControl x:Class="TableEntityBrowserPlugin.TableEntityBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1100">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="8" Grid.Row="0">
            <Button Content="Load Tables" Command="{Binding LoadTablesCommand}" />
            <Button Content="Load Entities" Command="{Binding LoadEntitiesCommand}" Margin="4,0,0,0" />
            <Button Content="Refresh All" Command="{Binding RefreshAllCommand}" Margin="4,0,0,0" />
            <Button Content="Import Tables" Command="{Binding ImportTablesCommand}" Margin="4,0,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#ccc" BorderThickness="1" Padding="8" Margin="0,0,8,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Tables" FontWeight="Bold" />
                        <TextBlock Text="Search" FontSize="10" Foreground="Gray" Margin="0,6,0,2" />
                        <TextBox Text="{Binding TableSearch, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <ListView ItemsSource="{Binding TablesView}"
                              SelectedItem="{Binding SelectedTable, Mode=TwoWay}"
                              Margin="0,8,0,0"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="140" />
                                <GridViewColumn Header="Label" DisplayMemberBinding="{Binding Label}" Width="140" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <TextBlock Text="{Binding TableListSummary}" FontSize="10" Foreground="Gray" />
                        <TextBlock Text="{Binding SelectedTableSummary}" FontSize="10" Foreground="Gray" />
                        <TextBox Text="{Binding SelectedTableBrowserUrl}" IsReadOnly="True" FontSize="10" />
                        <Button Content="Open Table Browser" Command="{Binding OpenTableBrowserCommand}" Margin="0,6,0,0" />
                        <TextBlock Text="Table Browser URL Template" FontSize="10" Foreground="Gray" Margin="0,10,0,2" />
                        <TextBox Text="{Binding TableBrowserTemplate, UpdateSourceTrigger=PropertyChanged}" FontSize="10" />
                        <TextBlock Text="Use {BaseUrl} and {TableName}" FontSize="9" Foreground="Gray" />
                        <Button Content="Save Template" Command="{Binding SaveTemplateCommand}" Margin="0,6,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" BorderBrush="#ccc" BorderThickness="1" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Entities" FontWeight="Bold" />
                        <TextBlock Text="Search" FontSize="10" Foreground="Gray" Margin="0,6,0,2" />
                        <TextBox Text="{Binding EntitySearch, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <ListView Grid.Row="1"
                              ItemsSource="{Binding EntitiesView}"
                              SelectedItem="{Binding SelectedEntity, Mode=TwoWay}"
                              Margin="0,8,0,0"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="200" />
                                <GridViewColumn Header="Fields" DisplayMemberBinding="{Binding PropertyCount}" Width="60" />
                                <GridViewColumn Header="Nav" DisplayMemberBinding="{Binding NavigationCount}" Width="50" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <TextBlock Text="{Binding EntityListSummary}" FontSize="10" Foreground="Gray" />
                        <TextBlock Text="{Binding SelectedEntitySummary}" FontSize="10" Foreground="Gray" />
                        <TextBox Text="{Binding SelectedEntityEndpoint}" IsReadOnly="True" FontSize="10" />
                    </StackPanel>

                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DataGrid Grid.Row="0"
                                  ItemsSource="{Binding EntityFields}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" />
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="220" />
                                <DataGridCheckBoxColumn Header="Nullable" Binding="{Binding Nullable}" Width="80" />
                                <DataGridTextColumn Header="Enum Values" Binding="{Binding EnumValues}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding NavigationHints}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="10" Foreground="Gray" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Margin="8" Text="{Binding Status}" />
    </Grid>
</UserControl>
