<UserControl x:Class="TableEntityBrowserPlugin.TableEntityBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:TableEntityBrowserPlugin"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1100">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:InverseBooleanConverter x:Key="NotBool" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <Button Content="Load Tables" Command="{Binding LoadTablesCommand}"
                        MinWidth="96" Padding="10,4"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource NotBool}}" />
                <Button Content="Load Entities" Command="{Binding LoadEntitiesCommand}"
                        MinWidth="96" Padding="10,4" Margin="6,0,0,0"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource NotBool}}" />
                <Button Content="Refresh All" Command="{Binding RefreshAllCommand}"
                        MinWidth="96" Padding="10,4" Margin="6,0,0,0"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource NotBool}}" />
                <Button Content="Import Tables" Command="{Binding ImportTablesCommand}"
                        MinWidth="96" Padding="10,4" Margin="6,0,0,0"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource NotBool}}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Working..." Foreground="Gray" Margin="0,0,8,0"
                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <ProgressBar Width="140" Height="10" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="260" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#f9fafb"
                    BorderBrush="#e5e7eb"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Tables" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="Search" FontSize="11" Foreground="Gray" Margin="0,10,0,2" />
                        <TextBox Text="{Binding TableSearch, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <ListView ItemsSource="{Binding TablesView}"
                              SelectedItem="{Binding SelectedTable, Mode=TwoWay}"
                              Margin="0,10,0,0"
                              BorderThickness="0"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="150" />
                                <GridViewColumn Header="Label" DisplayMemberBinding="{Binding Label}" Width="160" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <TextBlock Text="{Binding TableListSummary}" FontSize="11" Foreground="Gray" />
                        <TextBlock Text="{Binding SelectedTableSummary}" FontSize="11" Foreground="Gray" Margin="0,2,0,0" />

                        <TextBox Text="{Binding SelectedTableBrowserUrl}"
                                 IsReadOnly="True"
                                 FontSize="11"
                                 Margin="0,8,0,0"
                                 TextWrapping="NoWrap"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Hidden"
                                 ToolTip="{Binding SelectedTableBrowserUrl}" />

                        <Button Content="Open Table Browser"
                                Command="{Binding OpenTableBrowserCommand}"
                                Margin="0,6,0,0"
                                Padding="10,4" />

                        <Separator Margin="0,12,0,12" />

                        <TextBlock Text="Table Browser URL Template" FontSize="11" Foreground="Gray" Margin="0,0,0,2" />
                        <TextBox Text="{Binding TableBrowserTemplate, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="11"
                                 FontFamily="Consolas"
                                 ToolTip="Use {BaseUrl} and {TableName}" />
                        <TextBlock Text="Use {BaseUrl} and {TableName}" FontSize="10" Foreground="Gray" Margin="0,4,0,0" />
                        <Button Content="Save Template"
                                Command="{Binding SaveTemplateCommand}"
                                Margin="0,6,0,0"
                                Padding="10,4" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#e5e7eb"
                          ShowsPreview="True" />

            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="#e5e7eb"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Entities" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Text="Search" FontSize="11" Foreground="Gray" Margin="0,10,0,2" />
                        <TextBox Text="{Binding EntitySearch, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <ListView Grid.Row="1"
                              ItemsSource="{Binding EntitiesView}"
                              SelectedItem="{Binding SelectedEntity, Mode=TwoWay}"
                              Margin="0,10,0,0"
                              BorderThickness="0"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="240" />
                                <GridViewColumn Header="Fields" DisplayMemberBinding="{Binding PropertyCount}" Width="70" />
                                <GridViewColumn Header="Nav" DisplayMemberBinding="{Binding NavigationCount}" Width="60" />
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock Text="{Binding EntityListSummary}" FontSize="11" Foreground="Gray" />
                        <TextBlock Text="{Binding SelectedEntitySummary}" FontSize="11" Foreground="Gray" Margin="0,2,0,0" />
                        <TextBox Text="{Binding SelectedEntityEndpoint}"
                                 IsReadOnly="True"
                                 FontSize="11"
                                 Margin="0,8,0,0"
                                 TextWrapping="NoWrap"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Hidden"
                                 ToolTip="{Binding SelectedEntityEndpoint}" />
                    </StackPanel>

                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DataGrid Grid.Row="0"
                                  ItemsSource="{Binding EntityFields}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200" />
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="240" />
                                <DataGridCheckBoxColumn Header="Nullable" Binding="{Binding Nullable}" Width="90" />
                                <DataGridTextColumn Header="Enum Values" Binding="{Binding EnumValues}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding NavigationHints}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="Gray" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                BorderBrush="#e5e7eb"
                BorderThickness="0,1,0,0"
                Background="#f3f4f6"
                Padding="8">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>

