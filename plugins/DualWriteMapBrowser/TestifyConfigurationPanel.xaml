<UserControl x:Class="DualWriteMapBrowserPlugin.TestifyConfigurationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="520"
             d:DesignWidth="480">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Border Background="{DynamicResource Fo.SurfaceBrush}"
            BorderBrush="{DynamicResource Fo.BorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Fo.CornerRadius.Card}"
            Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <Button DockPanel.Dock="Right"
                        Content="✕"
                        Command="{Binding CloseCommand}"
                        Padding="8,2"
                        MinWidth="0"
                        ToolTip="Close" />
                <TextBlock Text="Testify Settings"
                           FontWeight="SemiBold"
                           FontSize="15"
                           VerticalAlignment="Center" />
            </DockPanel>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Omit Create Fields"
                               FontWeight="SemiBold"
                               Margin="0,0,0,2" />
                    <TextBlock Text="One field name per line."
                               Foreground="{DynamicResource Fo.SubtleTextBrush}"
                               Margin="0,0,0,4" />
                    <TextBox Text="{Binding OmitCreateFieldsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="80"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap" />

                    <TextBlock Text="Preferred Create Values"
                               FontWeight="SemiBold"
                               Margin="0,14,0,2" />
                    <TextBlock Text="One Field=Value entry per line."
                               Foreground="{DynamicResource Fo.SubtleTextBrush}"
                               Margin="0,0,0,4" />
                    <TextBox Text="{Binding PreferredCreateValuesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="96"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap" />

                    <TextBlock Text="CE Poll Timeout (minutes, 5–300)"
                               FontWeight="SemiBold"
                               Margin="0,14,0,2" />
                    <TextBox Text="{Binding CePollTimeoutMinutesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Width="120"
                             HorizontalAlignment="Left" />

                    <CheckBox Content="Allow partial enum coverage"
                              IsChecked="{Binding AllowPartialEnumCoverage, Mode=TwoWay}"
                              Margin="0,14,0,0" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <Separator Margin="0,0,0,10" />
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="Saving…"
                                   Margin="0,0,8,0"
                                   Foreground="{DynamicResource Fo.SubtleTextBrush}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsSaving, Converter={StaticResource BoolToVisibility}}" />
                        <ProgressBar Width="80"
                                     Height="6"
                                     IsIndeterminate="True"
                                     Visibility="{Binding IsSaving, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <Button Content="Save"
                            Command="{Binding SaveCommand}"
                            Padding="16,5"
                            MinWidth="80" />
                </DockPanel>

                <TextBlock Text="{Binding ConfirmationMessage}"
                           Margin="0,6,0,0"
                           Foreground="{DynamicResource Fo.SubtleTextBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
