<UserControl x:Class="ODataPostBuilderPlugin.ODataPostBuilderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ODataPostBuilderPlugin"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="1000">

  <UserControl.Resources>
    <local:BindingProxy x:Key="VmProxy" Data="{Binding}" />
    <DataTemplate x:Key="ValueTextTemplate">
      <TextBox Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    </DataTemplate>
    <DataTemplate x:Key="ValueBoolTemplate">
      <CheckBox IsThreeState="True" IsChecked="{Binding BoolValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    </DataTemplate>
    <DataTemplate x:Key="ValueEnumTemplate">
      <ComboBox ItemsSource="{Binding EnumMembers}"
                SelectedItem="{Binding EnumValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    </DataTemplate>
  </UserControl.Resources>

  <Grid Margin="12">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="280" MinWidth="240" />
      <ColumnDefinition Width="6" />
      <ColumnDefinition Width="*" MinWidth="520" />
      <ColumnDefinition Width="6" />
      <ColumnDefinition Width="440" MinWidth="380" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Grid.ColumnSpan="5"
               FontSize="16"
               FontWeight="SemiBold"
               Text="OData API Builder" />

    <!-- Left: entity picker -->
    <Grid Grid.Row="1" Grid.Column="0" Margin="0,12,12,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <StackPanel Orientation="Horizontal">
        <Button Content="Load Entities"
                Command="{Binding LoadEntitiesCommand}" />
        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding EntityLoadStatus}" TextWrapping="Wrap" />
      </StackPanel>

      <TextBox Grid.Row="1"
               Margin="0,8,0,8"
               Text="{Binding EntitySearch, UpdateSourceTrigger=PropertyChanged}"
               ToolTip="Search entities" />

      <ListBox Grid.Row="2"
               ItemsSource="{Binding EntitiesView}"
               SelectedItem="{Binding SelectedEntityItem}"
               DisplayMemberPath="Display"
               HorizontalContentAlignment="Stretch" />
    </Grid>

    <GridSplitter Grid.Row="1"
                  Grid.Column="1"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Background="{DynamicResource Fo.BorderBrush}"
                  ShowsPreview="True" />

    <!-- Center: field/value grid -->
    <Grid Grid.Row="1" Grid.Column="2" Margin="0,12,12,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <TextBlock Text="{Binding SelectedEntitySummary}" FontWeight="SemiBold" />

      <DataGrid Grid.Row="1"
                ItemsSource="{Binding Fields}"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserResizeColumns="True"
                HeadersVisibility="Column"
                IsReadOnly="False"
                ScrollViewer.HorizontalScrollBarVisibility="Auto">
        <DataGrid.Columns>
          <DataGridCheckBoxColumn Header="Include" Binding="{Binding Include, UpdateSourceTrigger=PropertyChanged}" Width="80" />
          <DataGridTextColumn Header="Name" Binding="{Binding Name}" IsReadOnly="True" Width="260" MinWidth="180" />
          <DataGridTextColumn Header="Type" Binding="{Binding Type}" IsReadOnly="True" Width="180" MinWidth="140" />
          <DataGridTextColumn Header="Mandatory" Binding="{Binding MandatoryText}" IsReadOnly="True" Width="120" MinWidth="100" />
          <DataGridTemplateColumn Header="Value" Width="260" MinWidth="200">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <!-- Bind Content so the chosen ContentTemplate receives the row item as DataContext.
                     Without this, virtualization will cause editor visuals to "bleed" across rows and edits won't persist. -->
                <ContentControl Content="{Binding}">
                  <ContentControl.Style>
                    <Style TargetType="ContentControl">
                      <Setter Property="ContentTemplate" Value="{StaticResource ValueTextTemplate}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding EditorKind}" Value="{x:Static local:PostFieldEditorKind.Boolean}">
                          <Setter Property="ContentTemplate" Value="{StaticResource ValueBoolTemplate}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding EditorKind}" Value="{x:Static local:PostFieldEditorKind.Enum}">
                          <Setter Property="ContentTemplate" Value="{StaticResource ValueEnumTemplate}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </ContentControl.Style>
                </ContentControl>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>

    <GridSplitter Grid.Row="1"
                  Grid.Column="3"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Background="{DynamicResource Fo.BorderBrush}"
                  ShowsPreview="True" />

    <!-- Right: single request + batch + saved -->
    <Grid Grid.Row="1" Grid.Column="4" Margin="0,12,0,0">
      <TabControl>
        <TabItem Header="Single">
          <Grid Margin="10">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <WrapPanel Orientation="Horizontal" ItemHeight="34">
              <TextBlock VerticalAlignment="Center" Text="Method:" Margin="0,0,6,0"/>
              <ComboBox Width="118" ItemsSource="{Binding Methods}" SelectedItem="{Binding SelectedMethod}" />
              <TextBlock VerticalAlignment="Center" Text="Cross-company:" Margin="12,0,6,0"/>
              <CheckBox VerticalAlignment="Center" IsChecked="{Binding CrossCompany}" IsEnabled="{Binding IsCrossCompanyApplicable}" ToolTip="When enabled, PATCH/DELETE URL includes ?cross-company=true" />
              <TextBlock VerticalAlignment="Center" Text="If-Match:*" Margin="12,0,6,0"/>
              <CheckBox VerticalAlignment="Center" IsChecked="{Binding UseIfMatchStar}" />
              <TextBox Width="120" Margin="8,0,0,0" Text="{Binding IfMatchCustom, UpdateSourceTrigger=PropertyChanged}" ToolTip="Custom If-Match value (overrides *)" />
            </WrapPanel>

            <Grid Grid.Row="1" Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" MinWidth="260" Text="{Binding ApiUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="API URL (can include key predicate for PATCH/DELETE)" />
              <Button Grid.Column="1" Margin="10,0,0,0" Content="Copy URL" Command="{Binding CopyUrlCommand}" />
            </Grid>

            <GroupBox Grid.Row="3" Header="Payload (JSON)" Margin="0,12,0,0">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                  <Button Content="Copy Payload" Command="{Binding CopyPayloadCommand}" />
                  <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding PayloadStatus}" />
                </StackPanel>
                <TextBox Grid.Row="1" Text="{Binding PayloadJson, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" MinHeight="170" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
              </Grid>
            </GroupBox>

            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0">
              <Button Content="{Binding SendButtonText, Mode=OneWay}" Command="{Binding SendCommand}" />
              <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding SendStatus}" TextWrapping="Wrap" />
            </StackPanel>

            <GroupBox Grid.Row="5" Header="Response" Margin="0,12,0,0">
              <TextBox Text="{Binding ResponseDetails, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" MinHeight="170" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
            </GroupBox>
          </Grid>
        </TabItem>

        <TabItem Header="Batch">
          <Grid Margin="10">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
              <Button Content="Add Current" Command="{Binding AddCurrentToBatchCommand}" />
              <Button Margin="8,0,0,0" Content="Remove" Command="{Binding RemoveSelectedBatchOpCommand}" />
              <Button Margin="8,0,0,0" Content="Clear" Command="{Binding ClearBatchCommand}" />
              <Button Margin="8,0,0,0" Content="Copy Batch" Command="{Binding CopyBatchCommand}" />
            </StackPanel>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding BatchOperations}"
                      SelectedItem="{Binding SelectedBatchOperation}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="True"
                      CanUserResizeColumns="True"
                      HeadersVisibility="Column"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
              <DataGrid.Columns>
                <DataGridComboBoxColumn Header="Method" Width="120"
                                        ItemsSource="{Binding Data.Methods, Source={StaticResource VmProxy}}"
                                        SelectedItemBinding="{Binding Method, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="URL" Width="360" MinWidth="260"
                                   Binding="{Binding Url, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="Body" Width="280" MinWidth="220"
                                   Binding="{Binding BodyJson, UpdateSourceTrigger=PropertyChanged}" />
              </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,10,0,0">
              <TextBlock Text="{Binding BatchUrl, Mode=OneWay}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding BatchContentType, Mode=OneWay}" TextWrapping="Wrap" />
            </StackPanel>

            <GroupBox Grid.Row="3" Header="Batch Body (preview)" Margin="0,12,0,0">
              <TextBox Text="{Binding BatchBodyPreview, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" MinHeight="150" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
            </GroupBox>

            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0">
              <Button Content="Send Batch" Command="{Binding SendBatchCommand}" />
              <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding BatchSendStatus}" TextWrapping="Wrap" />
            </StackPanel>

            <GroupBox Grid.Row="5" Header="Batch Response" Margin="0,12,0,0">
              <TextBox Text="{Binding BatchResponseDetails, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" MinHeight="150" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
            </GroupBox>
          </Grid>
        </TabItem>

        <TabItem Header="Saved">
          <Grid Margin="10">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
              <Button Content="Refresh" Command="{Binding LoadSavedRequestsCommand}" />
              <Button Margin="8,0,0,0" Content="Load" Command="{Binding LoadSelectedRequestCommand}" />
              <Button Margin="8,0,0,0" Content="Save" Command="{Binding SaveCurrentRequestCommand}" />
              <Button Margin="8,0,0,0" Content="Rename" Command="{Binding RenameSelectedRequestCommand}" />
              <Button Margin="8,0,0,0" Content="Delete" Command="{Binding DeleteSelectedRequestCommand}" />
            </StackPanel>

            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Margin="8,0,0,0" Content="Import" Command="{Binding ImportRequestsCommand}" />
              <Button Margin="8,0,0,0" Content="Export" Command="{Binding ExportSelectedRequestCommand}" />
              <Button Margin="8,0,0,0" Content="Export All" Command="{Binding ExportAllRequestsCommand}" />
            </StackPanel>

            <ListBox Grid.Row="1"
                     Grid.ColumnSpan="2"
                     ItemsSource="{Binding SavedRequests}"
                     SelectedItem="{Binding SelectedSavedRequest}"
                     DisplayMemberPath="Name"
                     HorizontalContentAlignment="Stretch" />

            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding SavedStatus, Mode=OneWay}" TextWrapping="Wrap" />
          </Grid>
        </TabItem>
      </TabControl>
    </Grid>

    <TextBlock Grid.Row="2" Grid.ColumnSpan="5" Margin="0,12,0,0" Text="{Binding Status}" TextWrapping="Wrap" />
  </Grid>
</UserControl>
