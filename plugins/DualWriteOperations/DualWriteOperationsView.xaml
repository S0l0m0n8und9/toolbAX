<UserControl x:Class="DualWriteOperationsPlugin.DualWriteOperationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:DualWriteOperationsPlugin"
             mc:Ignorable="d"
             d:DesignHeight="640"
             d:DesignWidth="1000">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Live environment warning -->
        <Border Grid.Row="0"
                Margin="8,8,8,0"
                Padding="10,6"
                Background="#33C04000"
                BorderBrush="#C04000"
                BorderThickness="1"
                CornerRadius="4">
            <TextBlock TextWrapping="Wrap"
                       FontWeight="SemiBold">
                <Run Text="⚠ Live environment:" />
                <Run Text="{Binding EnvironmentName, Mode=OneWay}" />
                <Run Text="— actions here affect real dual-write maps." />
            </TextBlock>
        </Border>

        <!-- Connection panel -->
        <Border Grid.Row="1"
                Margin="8"
                Padding="10"
                Background="{DynamicResource Fo.SurfaceAltBrush}"
                BorderBrush="{DynamicResource Fo.BorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Fo.CornerRadius.Card}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Gateway base URL" VerticalAlignment="Center" Margin="0,0,8,4" />
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,4"
                             Text="{Binding GatewayBaseUrl, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="e.g. https://projectmanagementservice.&lt;region&gt;.gateway.prod.island.powerapps.com" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="F&amp;O identifier" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Grid.Row="1" Grid.Column="1"
                             Text="{Binding FoIdentifier, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="The F&amp;O environment identifier used for the Environments lookup." />
                </Grid>

                <DockPanel Margin="0,8,0,0">
                    <Button DockPanel.Dock="Left" Content="Sign in…"
                            Command="{Binding SignInCommand}"
                            Padding="10,4" MinWidth="90"
                            ToolTip="Interactive sign-in: captures the token and auto-discovers the gateway."
                            IsEnabled="{Binding IsNotBusy}" />
                    <Button DockPanel.Dock="Left" Content="Switch account…"
                            Command="{Binding SignInFreshCommand}"
                            Padding="10,4" MinWidth="110" Margin="6,0,0,0"
                            ToolTip="Forget the cached browser session and sign in again, choosing a different account."
                            IsEnabled="{Binding IsNotBusy}" />
                    <Button DockPanel.Dock="Left" Content="Save Connection"
                            Command="{Binding SaveConnectionCommand}"
                            Padding="10,4" MinWidth="130" Margin="6,0,0,0"
                            ToolTip="Saves the gateway URL and F&amp;O identifier for this environment (keeps the stored sign-in session). Does not contact the gateway." />
                    <Button DockPanel.Dock="Left" Content="Clear Token"
                            Command="{Binding ClearTokenCommand}"
                            Padding="10,4" MinWidth="100" Margin="6,0,0,0"
                            ToolTip="Remove the stored sign-in session for this environment (keeps the gateway URL and identifier). Sign in again before loading maps."
                            IsEnabled="{Binding IsNotBusy}" />
                    <Button DockPanel.Dock="Left" Content="Load Maps"
                            Command="{Binding LoadMapsCommand}"
                            Padding="10,4" MinWidth="110" Margin="6,0,0,0"
                            ToolTip="Read-only. Resolves the connection and lists every dual-write map for this environment. Sign in (or save a connection) first."
                            IsEnabled="{Binding IsNotBusy}" />
                    <TextBlock VerticalAlignment="Center" Margin="12,0,0,0"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding ConnectionSummary}" />
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Maps grid (with search) -->
        <DockPanel Grid.Row="2" Margin="8,0,8,0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                <TextBlock Text="{Binding MapListSummary}" DockPanel.Dock="Right" VerticalAlignment="Center"
                           Margin="8,0,0,0" Foreground="{DynamicResource Fo.SubtleTextBrush}" />
                <TextBlock Text="Search:" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBox VerticalAlignment="Center"
                         Text="{Binding MapSearch, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Case-insensitive search across map name, CE entity, version, author, state and id. Filters the list only; it does not change which maps an action targets (use the checkboxes)." />
            </DockPanel>
            <DataGrid ItemsSource="{Binding MapsView}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserSortColumns="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      IsReadOnly="False">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="36" />
                    <DataGridTextColumn Header="Map" Binding="{Binding Name}" Width="2*" IsReadOnly="True" />
                    <DataGridTextColumn Header="CE Entity" Binding="{Binding CeEntity}" Width="*" IsReadOnly="True" />
                    <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="*" IsReadOnly="True" />
                    <DataGridTextColumn Header="Author" Binding="{Binding Author}" Width="*" IsReadOnly="True" />
                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="*" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- Action bar + status -->
        <Border Grid.Row="3"
                Margin="8"
                Padding="10"
                Background="{DynamicResource Fo.SurfaceAltBrush}"
                BorderBrush="{DynamicResource Fo.BorderBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Fo.CornerRadius.Card}">
            <StackPanel>
                <WrapPanel>
                    <Button Content="Start" Command="{Binding StartCommand}" Padding="12,4" MinWidth="84" IsEnabled="{Binding IsNotBusy}"
                            ToolTip="Mutating · checked map(s) · LIVE. Brings the selected map(s) online without re-running initial sync. Load maps and tick at least one first." />
                    <Button Content="Stop" Command="{Binding StopCommand}" Padding="12,4" MinWidth="84" Margin="6,0,0,0" IsEnabled="{Binding IsNotBusy}"
                            ToolTip="Mutating · checked map(s) · LIVE. Stops the selected map(s). Load maps and tick at least one first." />
                    <Button Content="Pause" Command="{Binding PauseCommand}" Padding="12,4" MinWidth="84" Margin="6,0,0,0" IsEnabled="{Binding IsNotBusy}"
                            ToolTip="Mutating · checked map(s) · LIVE. Pauses the selected map(s). Load maps and tick at least one first." />
                    <Button Content="Resume" Command="{Binding ResumeCommand}" Padding="12,4" MinWidth="84" Margin="6,0,0,0" IsEnabled="{Binding IsNotBusy}"
                            ToolTip="Mutating · checked map(s) · LIVE. Resumes the selected map(s). Load maps and tick at least one first." />
                    <Button Content="Initial Sync" Command="{Binding InitialSyncCommand}" Padding="12,4" MinWidth="100" Margin="6,0,0,0" IsEnabled="{Binding IsNotBusy}"
                            ToolTip="Mutating · checked map(s) · LIVE. Re-runs the initial data sync for the selected map(s); can be long-running." />
                    <Border Width="1" Margin="10,2" Background="{DynamicResource Fo.BorderBrush}" />
                    <Button Content="Apply Latest Version" Command="{Binding ApplyLatestVersionCommand}" Padding="12,4" MinWidth="140" IsEnabled="{Binding IsNotBusy}"
                            ToolTip="Mutating · checked map(s) · LIVE. Activates the latest template version on the selected map(s), restricted to the 'Apply-version author(s)' filter. Tick at least one map first." />
                    <Button Content="Refresh Tables" Command="{Binding RefreshTablesCommand}" Padding="12,4" MinWidth="110" Margin="6,0,0,0" IsEnabled="{Binding IsNotBusy}"
                            ToolTip="Mutating · checked map(s). Refreshes the table / field-mapping metadata for the selected map(s). Tick at least one map first." />
                    <Button Content="Export Config" Command="{Binding ExportConfigCommand}" Padding="12,4" MinWidth="110" Margin="6,0,0,0" IsEnabled="{Binding IsNotBusy}"
                            ToolTip="Read-only. Exports all loaded maps to a JSON file you choose. Does not change the environment or depend on the checkboxes." />
                    <TextBlock Text="Apply-version author(s):" VerticalAlignment="Center" Margin="8,0,4,0"
                               ToolTip="Scopes the 'Apply Latest Version' button only — restricts which template author's versions are considered. It does not filter the map list or affect Start/Stop/Pause/Resume, Refresh Tables, Export, Reset Link, or Apply Integration Keys." />
                    <TextBox Width="160" VerticalAlignment="Center"
                             Text="{Binding ApplyVersionAuthorFilter, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Comma-separated template authors used only by 'Apply Latest Version' (blank = any author). Does not filter the map list or affect Start/Stop/Pause/Resume, Refresh Tables, Export, Reset Link, or Apply Integration Keys." />
                    <Border Width="1" Margin="10,2" Background="{DynamicResource Fo.BorderBrush}" />
                    <Button Content="Reset Link" Command="{Binding ResetLinkCommand}" Padding="12,4" MinWidth="100" IsEnabled="{Binding IsNotBusy}"
                            ToolTip="Mutating · whole connection set · LIVE. Re-initialises the dual-write link for the connection set's legal entities — disruptive to running maps. Does not use the checkboxes; sign in first." />
                    <CheckBox Content="Force reset" VerticalAlignment="Center" Margin="8,0,0,0" IsChecked="{Binding ForceReset}"
                              ToolTip="When ticked, Reset Link forces the reset even if the link is currently active." />
                    <Button Content="Apply Integration Keys" Command="{Binding ApplyIntegrationKeysCommand}" Padding="12,4" MinWidth="160" Margin="8,0,0,0" IsEnabled="{Binding IsNotBusy}"
                            ToolTip="Mutating · checked map(s) · LIVE. Applies integration keys (from the connection set) for the selected map(s)' CE entities; maps without a resolved key are skipped. Tick at least one map first." />
                </WrapPanel>
                <DockPanel Margin="0,8,0,0">
                    <ProgressBar DockPanel.Dock="Left"
                                 Width="120"
                                 Height="6"
                                 IsIndeterminate="True"
                                 VerticalAlignment="Center"
                                 Margin="0,0,10,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Text="{Binding StatusMessage}" />
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
